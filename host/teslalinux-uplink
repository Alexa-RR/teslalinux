def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def ap_iface():
    m = re.search(r"^\s*AP_IFACE=['\"]?([A-Za-z0-9_.-]+)", read(ENV) or "", re.M)
    return m.group(1) if m else "wlan0"


def load_config():
    try:
        with open(CONFIG) as f:
            c = json.load(f)
        if isinstance(c, dict):
            return c
    except (OSError, ValueError):
        pass
    return {}


def kind(name):
    drv = os.path.basename(os.path.realpath("/sys/class/net/%s/device/driver" % name))
    if drv == "ipheth":
        return "phone"
    if drv in MODEM_DRIVERS or name.startswith("wwan"):
        return "lte"
    if os.path.isdir("/sys/class/net/%s/wireless" % name) or os.path.exists("/sys/class/net/%s/phy80211" % name):
        return "wifi"
    return "ethernet"


def wireless_ifaces():
    try:
        names = sorted(os.listdir("/sys/class/net"))
    except OSError:
        return []
    return [n for n in names if os.path.isdir("/sys/class/net/%s/wireless" % n) or os.path.exists("/sys/class/net/%s/phy80211" % n)]


def client_iface(cfg):
    want = cfg.get("iface") or ""
    ap = ap_iface()
    if want and want != ap and os.path.isdir("/sys/class/net/" + want):
        return want
    for n in wireless_ifaces():
        if n != ap:
            return n
    return None


def routes():
    """{iface: (gateway or None, metric)} of the DHCP default routes (ours, metric 5, left out) and the
    interface our route goes through now"""
    out, ours = {}, None
    try:
        with open("/proc/net/route") as f:
            next(f)
            for line in f:
                c = line.split()
                if len(c) < 8 or c[1] != "00000000" or c[7] != "00000000":
                    continue
                gw = socket.inet_ntoa(bytes.fromhex(c[2])[::-1]) if c[2] != "00000000" else None
                metric = int(c[6])
                if metric == METRIC:
                    ours = (c[0], gw)
                    continue
                if c[0] not in out or metric < out[c[0]][1]:
                    out[c[0]] = (gw, metric)
    except (OSError, ValueError, StopIteration):
        pass
    return out, ours


def probe(iface):
    """(ok, latency ms) of a TCP connection made through IFACE only"""
    for host, port in PROBES:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            s.setsockopt(socket.SOL_SOCKET, SO_BINDTODEVICE, iface.encode() + b"\0")
            s.settimeout(3)
            t0 = time.monotonic()
            s.connect((host, port))
            return True, int((time.monotonic() - t0) * 1000)
        except OSError:
            continue
        finally:
            s.close()
    return False, None


def set_route(iface, gw):
    cmd = ["ip", "-4", "route", "replace", "default"] + (["via", gw] if gw else []) + ["dev", iface, "metric", str(METRIC)]
    return subprocess.run(cmd, capture_output=True).returncode == 0


def clear_route():
    subprocess.run(["ip", "-4", "route", "del", "default", "metric", str(METRIC)], capture_output=True)


def wifi_link(iface):
    """(ssid, signal dBm) the Wi-Fi card is associated with, or (None, None)"""
    if not iface or not shutil.which("iw"):
        return None, None
    out = subprocess.run(["iw", "dev", iface, "link"], capture_output=True, text=True).stdout
    ssid = re.search(r"^\s*SSID: (.*)$", out, re.M)
    sig = re.search(r"^\s*signal: (-?\d+)", out, re.M)
    if not ssid:
        return None, None

    def unescape(s):
        try:
            return re.sub(rb"\\x([0-9a-fA-F]{2})", lambda m: bytes([int(m.group(1), 16)]), s.encode("latin-1", "backslashreplace")).decode("utf-8", "replace")
        except UnicodeError:
            return s
    return unescape(ssid.group(1)), int(sig.group(1)) if sig else None


def nm_running():
    if not shutil.which("nmcli"):
        return False
    r = subprocess.run(["nmcli", "-t", "-f", "RUNNING", "general"], capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.strip() == "running"


class Wpa:
    """wpa_supplicant on the second Wi-Fi card where NetworkManager does not run"""

    def __init__(self):
        self.iface, self.mtime = None, None

    def pid(self):
        p = read(WPA_PID)
        if p and p.isdigit() and os.path.exists("/proc/%s" % p):
            return int(p)
        return None

    def stop(self):
        p = self.pid()
        if p:
            try:
                os.kill(p, signal.SIGTERM)
            except OSError:
                pass
        self.iface = None

    def ensure(self, cfg, iface):
        if not cfg.get("enabled", True) or not iface or not cfg.get("networks") or not os.path.exists(WPA_CONF) \
                or not shutil.which("wpa_supplicant"):
            if self.pid():
                self.stop()
            return
        try:
            mtime = os.stat(WPA_CONF).st_mtime
        except OSError:
            return
        if self.pid() and self.iface == iface and self.mtime == mtime:
            return
        self.stop()
        time.sleep(0.5)
        subprocess.run(["ip", "link", "set", iface, "up"], capture_output=True)
        r = subprocess.run(["wpa_supplicant", "-B", "-D", "nl80211", "-i", iface, "-c", WPA_CONF, "-P", WPA_PID],
                           capture_output=True, text=True)
        if r.returncode == 0:
            self.iface, self.mtime = iface, mtime
        else:
            print("teslalinux-uplink: wpa_supplicant on %s failed: %s" % (iface, r.stderr.strip()), flush=True)


