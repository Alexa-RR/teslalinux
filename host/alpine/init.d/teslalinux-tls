#!/sbin/openrc-run
# teslalinux: keep the shared car certificate current. teslalinux-tls daemon fetches both slots and
# active.json from TLS_BASE_URL, installs a pair only when it passes every check, serves the active
# slot (or the other valid one), at start (jittered), every 6 h, with exponential backoff, and at
# once when an uplink comes up (dhcpcd's exit hook sends SIGUSR1). It never blocks boot or nginx:
# nginx starts with whatever pair (or self-signed fallback) is already there, and this only reloads it.
description="teslalinux certificate fetcher"
command=/usr/local/bin/teslalinux-tls
command_args="daemon"
command_background=true
pidfile=/run/teslalinux-tls-supervisor.pid
output_log=/var/log/teslalinux/tls.log
error_log=/var/log/teslalinux/tls.log
supervisor=supervise-daemon
respawn_delay=30
respawn_max=0

depend() {
	need localmount
	after net chronyd nginx teslalinux-netconfig
	use dns
}

start_pre() {
	checkpath -d -m 0755 -o root:root /var/log/teslalinux /var/lib/teslalinux/tls-state
}
