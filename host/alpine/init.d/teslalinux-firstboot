#!/sbin/openrc-run
# teslalinux: one-shot first boot: grow the root filesystem to the card and install the bundled car
# certificate pairs (teslalinux-tls init; a self-signed fallback when none passes the checks)
description="teslalinux first boot"

depend() {
	need localmount
	before teslalinux-netconfig nginx hostapd dnsmasq tacomp
}

start() {
	[ -e /etc/teslalinux/.firstboot-done ] && return 0
	ebegin "teslalinux first boot"
	/usr/local/bin/teslalinux-firstboot
	eend $?
}
