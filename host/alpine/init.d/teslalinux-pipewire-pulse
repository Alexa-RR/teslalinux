#!/sbin/openrc-run
# teslalinux: the PulseAudio protocol on PipeWire (/run/tesla/pulse/native): audio.py's ffmpeg
# reads android.monitor through it.
description="teslalinux pipewire-pulse"
command=/usr/bin/pipewire-pulse
command_user="tesla:tesla"
command_background=true
pidfile=/run/teslalinux-pipewire-pulse.pid
output_log=/var/log/teslalinux/pipewire-pulse.log
error_log=/var/log/teslalinux/pipewire-pulse.log
supervisor=supervise-daemon
respawn_delay=1
respawn_max=0

depend() {
	need teslalinux-pipewire
}

start_pre() {
	export XDG_RUNTIME_DIR=/run/tesla HOME=/var/lib/tesla
	i=0; while [ ! -S /run/tesla/pipewire-0 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
}
