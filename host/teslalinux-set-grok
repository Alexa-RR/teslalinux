#!/usr/bin/env python3
"""teslalinux: Grok remote control's settings and the tunnel token, stored as root.

Called by services/grok/grok.py (Settings > Grok on the car page) through one sudoers rule, with
one JSON object on its standard input (so a token is never on a command line):

  {"enabled": true|false, "hostname": "mcp.example.com", "teamDomain": "https://team.cloudflareaccess.com",
   "aud": "<64 hex>", "email": "driver@example.com", "tunnelToken": "eyJ...", "clearToken": true}

Every key is optional; what is given is checked and changed, the rest kept. Writes:
  /etc/teslalinux/grok.env          the settings (0644: no secrets; grok.py reads it)
  /etc/teslalinux/grok/tunnel.env   TUNNEL_TOKEN=... (0600 root in a 0700 root directory; only
                                    systemd reads it, for teslalinux-cloudflared.service)
Then the tunnel runs exactly while remote control is on and a token is stored:
teslalinux-cloudflared.service is enabled and (re)started, or stopped and disabled.
Prints one line saying what it did; exit 2 for a refused value.
"""
import base64
import json
import os
import re
import subprocess
import sys
import uuid

CONF = os.environ.get("TESLALINUX_GROK_CONFIG", "/etc/teslalinux/grok.env")
SECRET_DIR = os.environ.get("TESLALINUX_GROK_SECRET_DIR", "/etc/teslalinux/grok")
UNIT = "teslalinux-cloudflared.service"
HOST_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
EMAIL_RE = re.compile(r"^[^@\s\"'\\]{1,64}@[^@\s\"'\\]{1,255}$")
KEYS = ("ENABLED", "HOSTNAME", "TEAM_DOMAIN", "AUD", "EMAIL", "TUNNEL_ID", "TOKEN_SET")


def die(msg, code=2):
    print("teslalinux-set-grok: " + msg, file=sys.stderr)
    sys.exit(code)


def read_conf():
    out = {}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line.startswith("TESLALINUX_GROK_") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k[len("TESLALINUX_GROK_"):]] = v.strip().strip('"')
    except OSError:
        pass
    return out


def write_atomic(path, text, mode):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def team_domain(v):
    v = v.strip().rstrip("/")
    m = re.match(r"^(https)://([a-z0-9.-]+)$", v.lower())
    if m and HOST_RE.match(m.group(2)):
        return v.lower()
    # a loopback test issuer (the VM's end-to-end test); never anything else in plain HTTP
    m = re.match(r"^http://127\.0\.0\.1:(\d{2,5})$", v)
    if m:
        return v
    if re.match(r"^[a-z0-9-]{1,63}$", v.lower()):  # just the team name
        return "https://%s.cloudflareaccess.com" % v.lower()
    die("the team domain must be https://<team>.cloudflareaccess.com")


def tunnel_id(token):
    """The tunnel id in a remotely managed tunnel's token (base64 JSON: a account, t tunnel, s secret)."""
    try:
        d = json.loads(base64.b64decode(token + "=" * (-len(token) % 4)).decode())
        t = str(uuid.UUID(d["t"]))
        if not d.get("a") or not d.get("s"):
            raise ValueError
        return t
    except (ValueError, KeyError, TypeError, UnicodeDecodeError):
        die("that is not a Cloudflare Tunnel token (the long eyJ... text from the tunnel's install command)")


def systemctl(*args):
    # TESLALINUX_GROK_NO_SYSTEMCTL: the tests (sudo drops it, so the device always switches the unit)
    if not os.path.isdir("/run/systemd/system") or os.environ.get("TESLALINUX_GROK_NO_SYSTEMCTL") == "1":
        return
    subprocess.run(["systemctl"] + list(args), check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    try:
        req = json.loads(sys.stdin.read(65536) or "{}")
    except ValueError:
        die("the request is not JSON")
    if not isinstance(req, dict):
        die("the request is not an object")
    conf = read_conf()
    token_changed = False
    done = []
    if "hostname" in req:
        h = str(req["hostname"] or "").strip().lower().rstrip(".")
        if h and not HOST_RE.match(h):
            die("%r is not a hostname" % h)
        conf["HOSTNAME"] = h
        done.append("hostname")
    if "teamDomain" in req:
        conf["TEAM_DOMAIN"] = team_domain(str(req["teamDomain"] or "")) if req["teamDomain"] else ""
        done.append("team domain")
    if "aud" in req:
        a = str(req["aud"] or "").strip().lower()
        if a and not re.match(r"^[0-9a-f]{64}$", a):
            die("the AUD tag is 64 hexadecimal characters (Access application > Basic information)")
        conf["AUD"] = a
        done.append("AUD tag")
    if "email" in req:
        e = str(req["email"] or "").strip()
        if e and not EMAIL_RE.match(e):
            die("%r is not an email address" % e)
        conf["EMAIL"] = e
    os.makedirs(SECRET_DIR, mode=0o700, exist_ok=True)
    os.chmod(SECRET_DIR, 0o700)
    secret = os.path.join(SECRET_DIR, "tunnel.env")
    if req.get("clearToken"):
        try:
            os.remove(secret)
        except FileNotFoundError:
            pass
        conf["TUNNEL_ID"] = ""
        conf["TOKEN_SET"] = "0"
        token_changed = True
        done.append("token removed")
    elif "tunnelToken" in req:
        tok = str(req["tunnelToken"] or "").strip()
        if not re.match(r"^[A-Za-z0-9+/=_-]{40,4096}$", tok):
            die("that is not a Cloudflare Tunnel token (the long eyJ... text from the tunnel's install command)")
        conf["TUNNEL_ID"] = tunnel_id(tok)
        old = ""
        try:
            with open(secret) as f:
                old = f.read()
        except OSError:
            pass
        new = "# teslalinux Grok remote control: the Cloudflare Tunnel token (teslalinux-set-grok)\nTUNNEL_TOKEN=%s\n" % tok
        token_changed = new != old
        write_atomic(secret, new, 0o600)
        conf["TOKEN_SET"] = "1"
        done.append("tunnel token")
    if "enabled" in req:
        conf["ENABLED"] = "1" if req["enabled"] is True else "0"
        done.append("on" if req["enabled"] is True else "off")
    lines = ["# teslalinux Grok remote control (teslalinux-set-grok, from the settings page; docs/GROK.md)"]
    for k in KEYS:
        if conf.get(k):
            lines.append("TESLALINUX_GROK_%s=%s" % (k, conf[k]))
    write_atomic(CONF, "\n".join(lines) + "\n", 0o644)

    run = conf.get("ENABLED") == "1" and conf.get("TOKEN_SET") == "1" and os.path.exists(secret)
    if run:
        systemctl("enable", "--quiet", UNIT)
        systemctl("restart" if token_changed else "start", UNIT)
        state = "the tunnel runs"
    else:
        systemctl("disable", "--now", "--quiet", UNIT)
        state = "the tunnel is off" + ("" if conf.get("TOKEN_SET") == "1" else " (no token)")
    print("Saved%s; %s." % ((" (" + ", ".join(done) + ")") if done else "", state))


if __name__ == "__main__":
    main()
