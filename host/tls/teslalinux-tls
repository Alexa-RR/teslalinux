#!/bin/sh
# teslalinux-tls: the car's TLS certificate on the Pi. Every teslalinux car serves the same names
# (DEVICE_HOST, www., fullscreen., www.fullscreen.; car.alexahub.dev by default) with the same
# publicly trusted certificate and key, issued in the cloud by .github/workflows/tls-certs.yml and
# published at TLS_BASE_URL. The key is public in effect (every Pi and every release holds it); what
# this tool guarantees is that nginx only ever serves a pair that is trusted, carries exactly the
# expected names, is current, and matches its key. No DNS or ACME credential exists on the Pi.
#
# Two slots, issued independently (see docs/CAR-STACK-READINESS.md, "Certificate"):
#   current   the four names
#   standby   the four names + standby.DEVICE_HOST (another name set, so a revoked or rate-limited
#             current never takes the standby with it)
# TLS_BASE_URL/active.json ({"slot": "current"|"standby", ...}) names the slot to serve; when that
# slot's pair is missing, expired or invalid here, the other valid one is served; when neither is,
# a self-signed certificate (the browser warns until a trusted pair arrives).
#
#   teslalinux-tls init        boot / install: take the bundled pairs (TLS_BUNDLE_DIR, from the
#                              release) if they pass every check, then serve the best pair
#   teslalinux-tls fetch       one check: read the DNS version pointer (below) and download, verify and
#                              install only what differs from what is installed; without a usable
#                              pointer, the full download of both slots and active.json, at most every
#                              TLS_FETCH_INTERVAL (6 h) while a trusted pair is served
#                              (exit 0 = a trusted pair is served and the check worked)
#   teslalinux-tls fetch --full   the full download now, whatever the pointer says
#   teslalinux-tls pointer [TEXT] look the pointer up and print it (or parse TEXT); exit 1 = none usable
#   teslalinux-tls select      serve the best installed pair again (no download)
#   teslalinux-tls verify SLOT CHAIN KEY   run every acceptance check on local files, install nothing
#                              (the cloud issuer runs this same check before it publishes)
#   teslalinux-tls crl-status CHAIN CRL    good | revoked | unknown: the leaf's serial in a CRL
#                              (PEM or DER) signed by the chain's issuer (used by the cloud issuer)
#   teslalinux-tls daemon      (OpenRC) fetch at start (jittered), every TLS_CHECK_INTERVAL (1 h),
#                              exponential backoff on failure, SIGUSR1 = try now
#   teslalinux-tls kick        an uplink came up (NetworkManager dispatcher / dhcpcd hook): start
#                              teslalinux-tls-fetch.service (systemd) or wake the daemon (OpenRC),
#                              unless the last success is less than TLS_KICK_MIN_AGE (600 s) old
#   teslalinux-tls status      print the state file
# On Pi OS (systemd) teslalinux-tls-fetch.timer runs `fetch` at boot and every hour with a small
# random delay; the service's Restart=on-failure with RestartSteps/RestartMaxDelaySec is the backoff.
#
# The version pointer: the issuer keeps one TXT record, TLS_POINTER_NAME (default
# _car-certs.<DEVICE_HOST without its first label>, e.g. _car-certs.alexahub.dev; never under
# DEVICE_HOST, whose whole subtree the Pi's own dnsmasq answers with HIJACK_IP), at
#   v=1 active=<slot> current=<sha256 of current/fullchain.pem> standby=<sha256 ...> t=<unix time>
# ("-" = that slot is not published). A check asks public resolvers (TLS_DNS_RESOLVERS) for it
# directly, never the local dnsmasq; nothing to download costs about 200 bytes. A slot whose chain
# differs from the pointer is downloaded (chain and key), active.json only when its slot differs.
# The answer is untrusted by design: it only decides WHETHER to download. Every downloaded file
# passes exactly the checks below, so a forged or withheld answer can only skip a download or
# trigger a verified one. Where delv is installed the answer is DNSSEC-validated by this Pi itself
# (from the root trust anchor, not trusting the resolver); dig is the unvalidated fallback.
# Falls back to the full download (rate-limited to TLS_FETCH_INTERVAL while a trusted pair is
# served): no usable answer (timeout, no record, malformed); a download that is not yet the
# pointer's chain (the CDN caches) for longer than one check; a pointer that keeps saying
# "unchanged" while the served certificate has less than a quarter of its lifetime left.
#
# Acceptance of a downloaded pair for SLOT (all must hold, else it is rejected and the installed one
# stays): the chain holds only CERTIFICATE PEM blocks, 1..5 of them; the key file holds exactly one
# PRIVATE KEY block; each at most TLS_MAX_BYTES; the key's public key equals the leaf's; the leaf's
# SANs are exactly SLOT's names; key usage digitalSignature and EKU serverAuth; the chain verifies
# against the system trust store (-purpose sslserver -x509_strict); notBefore <= now + skew,
# notAfter > now; and notBefore later than the installed pair of that slot (no downgrade). A clock
# before the image build time defers instead of judging.
# Install: temp files, fsync, rename; the served copy (TLS_CERT, TLS_KEY) the same way, then
# `nginx -t` and reload; on failure the previous files come back.
set -u
umask 077

ENV_FILE=${TESLALINUX_ENV:-/etc/teslalinux/env}
[ -r "$ENV_FILE" ] && . "$ENV_FILE"
DEVICE_HOST=${DEVICE_HOST:-}
TLS_CERT=${TLS_CERT:-/etc/teslalinux/tls/fullchain.pem}
TLS_KEY=${TLS_KEY:-/etc/teslalinux/tls/privkey.pem}
TLS_DIR=$(dirname "$TLS_KEY")
TLS_SLOTS_DIR=${TLS_SLOTS_DIR:-$TLS_DIR/slots}
TLS_SELF_DIR=${TLS_SELF_DIR:-$TLS_DIR/selfsigned}
TLS_STATE=${TLS_STATE:-/var/lib/teslalinux/tls-state/tls.json}
# unset: the default issuer; set to empty: no fetching (local test setups)
if [ -z "${TLS_BASE_URL+x}" ]; then
	case "${TLS_FETCH_URL:-}" in
		# an env file from the per-device design: .../current/fullchain.pem -> its base
		https://*/current/fullchain.pem) TLS_BASE_URL=${TLS_FETCH_URL%/current/fullchain.pem} ;;
		*) TLS_BASE_URL=https://certs.alexahub.dev/car ;;
	esac
fi
TLS_CAFILE=${TLS_CAFILE:-/etc/ssl/certs/ca-certificates.crt}
TLS_BUNDLE_DIR=${TLS_BUNDLE_DIR:-/usr/share/teslalinux/tls}
TLS_MAX_BYTES=${TLS_MAX_BYTES:-65536}
# the full download (no usable pointer) at most this often while a trusted pair is served
TLS_FETCH_INTERVAL=${TLS_FETCH_INTERVAL:-21600}
# the daemon's pointer check (systemd: teslalinux-tls-fetch.timer)
TLS_CHECK_INTERVAL=${TLS_CHECK_INTERVAL:-3600}
# unset: _car-certs.<DEVICE_HOST without its first label>; set to empty: no pointer (full downloads)
if [ -z "${TLS_POINTER_NAME+x}" ]; then
	case "$DEVICE_HOST" in
		*.*.*) TLS_POINTER_NAME="_car-certs.${DEVICE_HOST#*.}" ;;
		*) TLS_POINTER_NAME="" ;;
	esac
fi
TLS_DNS_RESOLVERS=${TLS_DNS_RESOLVERS:-1.1.1.1 8.8.8.8}
TLS_CLOCK_SKEW=${TLS_CLOCK_SKEW:-600}
TLS_BUILD_TIME_FILE=${TLS_BUILD_TIME_FILE:-/etc/teslalinux/build-time}
TLS_NO_RELOAD=${TLS_NO_RELOAD:-0}
TLS_KICK_MIN_AGE=${TLS_KICK_MIN_AGE:-600}
FETCH_UNIT=teslalinux-tls-fetch.service
PIDFILE=${TLS_PIDFILE:-/run/teslalinux-tls.pid}
SLOTS="current standby"
ACTIVE_FILE="$TLS_DIR/active.json"
SERVED_FILE="$TLS_DIR/served"

log() { printf '%s teslalinux-tls: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2; }
REASON=""
reject() { REASON=$*; log "reject: $*"; return 1; }

TMP=""
cleanup() { [ -n "$TMP" ] && rm -rf "$TMP"; }
trap cleanup EXIT
mktmp() { [ -n "$TMP" ] || TMP=$(mktemp -d "${TMPDIR:-/tmp}/teslalinux-tls.XXXXXX"); }

# ---------------------------------------------------------------- helpers

# "Nov  9 12:00:00 2026 GMT" (OpenSSL/LibreSSL default) or "2026-11-09 12:00:00Z" -> epoch seconds
to_epoch() {
	printf '%s\n' "$1" | awk '
	function days(y, m, d) { if (m <= 2) { y--; m += 12 } return 365*y + int(y/4) - int(y/100) + int(y/400) + int((153*(m-3)+2)/5) + d - 719469 }
	{
		if ($0 ~ /^[0-9][0-9][0-9][0-9]-/) { split($0, a, /[-: TZ]+/); y=a[1]; mo=a[2]+0; d=a[3]; t=a[4] ":" a[5] ":" a[6] }
		else { mo = index("JanFebMarAprMayJunJulAugSepOctNovDec", $1); if (!mo) exit 1; mo = (mo + 2) / 3; d=$2; t=$3; y=$4 }
		split(t, h, ":"); printf "%d\n", days(y+0, mo, d+0) * 86400 + h[1]*3600 + h[2]*60 + h[3]
	}'
}
cert_date() { to_epoch "$(openssl x509 -in "$1" -noout "-$2" 2>/dev/null | cut -d= -f2-)"; }
sha256_stdin() { openssl dgst -sha256 -r | cut -d' ' -f1; }
spki_of_key() { openssl pkey -in "$1" -pubout -outform DER 2>/dev/null | sha256_stdin; }
spki_of_cert() { openssl x509 -in "$1" -noout -pubkey 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256_stdin; }
first_cert() { awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{if(p) exit}' "$1"; }
rest_certs() { awk '/-----BEGIN CERTIFICATE-----/{n++} n>1{print}' "$1"; }
# the value lines of a text extension ("X509v3 Subject Alternative Name:" and the line after it)
ext_line() { openssl x509 -in "$1" -noout -text 2>/dev/null | awk -v h="$2" 'f{sub(/^[ \t]+/, ""); print; exit} index($0, h){f=1}'; }
sorted_words() { tr ', ' '\n\n' | sed '/^$/d' | sort | tr '\n' ' ' | sed 's/ $//'; }
now() { date +%s; }
random_below() { # $1 > 0
	r=$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')
	echo $(( ${r:-$$} % $1 ))
}
json_str() { printf '%s' "$1" | tr -d '\000-\037"\\' ; }
fsize() { wc -c <"$1" | tr -d ' '; }

valid_slot() { case "$1" in current|standby) return 0 ;; *) return 1 ;; esac; }
other_slot() { if [ "$1" = standby ]; then echo current; else echo standby; fi; }
slot_names() { # the exact SAN set of a slot
	printf '%s %s %s %s' "$DEVICE_HOST" "www.$DEVICE_HOST" "fullscreen.$DEVICE_HOST" "www.fullscreen.$DEVICE_HOST"
	[ "$1" = standby ] && printf ' %s' "standby.$DEVICE_HOST"
	echo
}

is_trusted_chain() { # $1 chain file [$2 = notime]: verifies against the trust store (purpose sslserver)
	mktmp
	first_cert "$1" >"$TMP/t-leaf.pem"
	rest_certs "$1" >"$TMP/t-rest.pem"
	nt=""; [ "${2:-}" = notime ] && nt=-no_check_time
	set -- -purpose sslserver -x509_strict -no-CApath -no-CAstore -CAfile "$TLS_CAFILE"
	[ -n "$nt" ] && set -- "$nt" "$@"
	[ -s "$TMP/t-rest.pem" ] && set -- "$@" -untrusted "$TMP/t-rest.pem"
	openssl verify "$@" "$TMP/t-leaf.pem" >/dev/null 2>&1
}

clock_is_set() {
	built=0
	[ -r "$TLS_BUILD_TIME_FILE" ] && built=$(tr -dc 0-9 <"$TLS_BUILD_TIME_FILE")
	[ "$(now)" -ge "${built:-0}" ]
}

reload_nginx() {
	[ "$TLS_NO_RELOAD" = 1 ] && return 0
	command -v nginx >/dev/null 2>&1 || return 0
	if command -v rc-service >/dev/null 2>&1 && rc-service -e nginx 2>/dev/null; then
		rc-service nginx status >/dev/null 2>&1 || return 0
		rc-service nginx reload >/dev/null 2>&1 && return 0
	fi
	if command -v systemctl >/dev/null 2>&1 && systemctl is-active -q nginx 2>/dev/null; then
		systemctl reload nginx && return 0
	fi
	nginx -s reload >/dev/null 2>&1 || true
}
nginx_config_ok() {
	[ "$TLS_NO_RELOAD" = 1 ] && return 0
	command -v nginx >/dev/null 2>&1 || return 0
	nginx -t -q >/dev/null 2>&1
}

# ---------------------------------------------------------------- checks

pem_chain_ok() { # only CERTIFICATE blocks, 1..5 of them
	grep -q '^-----BEGIN ' "$1" || return 1
	[ -z "$(grep '^-----BEGIN ' "$1" | grep -v '^-----BEGIN CERTIFICATE-----$')" ] || return 1
	n=$(grep -c '^-----BEGIN CERTIFICATE-----$' "$1")
	[ "$n" -ge 1 ] && [ "$n" -le 5 ]
}
pem_key_ok() { # exactly one private key block and nothing else
	[ "$(grep -c '^-----BEGIN ' "$1")" = 1 ] || return 1
	grep -q '^-----BEGIN \(EC \)\{0,1\}PRIVATE KEY-----$' "$1" || return 1
	openssl pkey -in "$1" -noout >/dev/null 2>&1
}

# check_pair SLOT CHAIN KEY: everything but the "newer than installed" rule.
# 0 = good, 1 = reject (REASON), 2 = clock not set (all but the time checks passed)
check_pair() {
	slot=$1 f=$2 k=$3 REASON=""
	valid_slot "$slot" || { reject "unknown slot '$slot'"; return 1; }
	[ -s "$f" ] || { reject "$slot: empty or missing chain"; return 1; }
	[ -s "$k" ] || { reject "$slot: empty or missing key"; return 1; }
	[ "$(fsize "$f")" -le "$TLS_MAX_BYTES" ] || { reject "$slot: chain is $(fsize "$f") bytes (limit $TLS_MAX_BYTES)"; return 1; }
	[ "$(fsize "$k")" -le "$TLS_MAX_BYTES" ] || { reject "$slot: key is $(fsize "$k") bytes (limit $TLS_MAX_BYTES)"; return 1; }
	pem_chain_ok "$f" || { reject "$slot: not a PEM certificate chain (only 1..5 CERTIFICATE blocks are accepted)"; return 1; }
	pem_key_ok "$k" || { reject "$slot: not a single PEM private key"; return 1; }
	mktmp
	first_cert "$f" >"$TMP/leaf.pem"
	openssl x509 -in "$TMP/leaf.pem" -noout >/dev/null 2>&1 || { reject "$slot: leaf does not parse"; return 1; }
	leaf_spki=$(spki_of_cert "$TMP/leaf.pem")
	[ -n "$leaf_spki" ] && [ "$leaf_spki" = "$(spki_of_key "$k")" ] || { reject "$slot: the private key does not match the leaf certificate"; return 1; }
	got=$(ext_line "$TMP/leaf.pem" "X509v3 Subject Alternative Name" | sorted_words)
	want=$(for n in $(slot_names "$slot"); do printf 'DNS:%s\n' "$n"; done | sorted_words)
	[ "$got" = "$want" ] || { reject "$slot: SANs '$got' differ from '$want'"; return 1; }
	ext_line "$TMP/leaf.pem" "X509v3 Key Usage" | grep -q "Digital Signature" || { reject "$slot: key usage lacks digitalSignature"; return 1; }
	ext_line "$TMP/leaf.pem" "X509v3 Extended Key Usage" | grep -q "TLS Web Server Authentication" || { reject "$slot: EKU lacks serverAuth"; return 1; }
	if ! clock_is_set; then
		is_trusted_chain "$f" notime || { reject "$slot: does not chain to the system trust store ($TLS_CAFILE) for TLS server use"; return 1; }
		REASON="clock not set yet (before the image build time)"
		return 2
	fi
	t=$(now)
	nb=$(cert_date "$TMP/leaf.pem" startdate); na=$(cert_date "$TMP/leaf.pem" enddate)
	[ -n "$nb" ] && [ -n "$na" ] || { reject "$slot: validity dates unreadable"; return 1; }
	[ "$nb" -le $((t + TLS_CLOCK_SKEW)) ] || { reject "$slot: not valid yet (notBefore $nb, now $t)"; return 1; }
	[ "$na" -gt "$t" ] || { reject "$slot: expired (notAfter $na, now $t)"; return 1; }
	is_trusted_chain "$f" || { reject "$slot: does not chain to the system trust store ($TLS_CAFILE) for TLS server use"; return 1; }
	return 0
}

# accept_pair SLOT CHAIN KEY: 0 = install it, 3 = the installed pair already, 2 = defer, 1 = reject
accept_pair() {
	check_pair "$1" "$2" "$3"; rc=$?
	if [ "$rc" = 2 ]; then log "defer: $REASON"; return 2; fi
	[ "$rc" = 0 ] || return 1
	cur="$TLS_SLOTS_DIR/$1"
	if [ -s "$cur/fullchain.pem" ]; then
		if [ "$(sha256_stdin <"$2")" = "$(sha256_stdin <"$cur/fullchain.pem")" ]; then
			REASON="unchanged"; return 3
		fi
		cur_nb=$(cert_date "$cur/fullchain.pem" startdate)
		new_nb=$(cert_date "$2" startdate)
		if [ -n "$cur_nb" ] && [ "$new_nb" -le "$cur_nb" ]; then
			reject "$1: not newer than the installed pair (notBefore $new_nb <= $cur_nb)"; return 1
		fi
	fi
	return 0
}

# pair_usable SLOT DIR: may this installed pair be served now?
pair_usable() {
	check_pair "$1" "$2/fullchain.pem" "$2/privkey.pem" 2>/dev/null; rc=$?
	[ "$rc" = 0 ] || [ "$rc" = 2 ]
}

# ---------------------------------------------------------------- files

put_pair() { # SRC_CHAIN SRC_KEY DST_CHAIN DST_KEY: temp, fsync, keep .prev, rename
	mkdir -p "$(dirname "$3")" "$(dirname "$4")" || return 1
	cp "$1" "$3.new" && chmod 0644 "$3.new" || return 1
	cp "$2" "$4.new" && chmod 0600 "$4.new" || return 1
	sync
	rm -f "$3.prev" "$4.prev"
	[ -s "$3" ] && cp -p "$3" "$3.prev"
	[ -s "$4" ] && cp -p "$4" "$4.prev"
	mv -f "$4.new" "$4" && mv -f "$3.new" "$3" || return 1
	sync
}
restore_pair() { # DST_CHAIN DST_KEY: back to .prev (or gone when there was none)
	if [ -s "$1.prev" ]; then mv -f "$1.prev" "$1"; else rm -f "$1"; fi
	if [ -s "$2.prev" ]; then mv -f "$2.prev" "$2"; else rm -f "$2"; fi
	sync
}

install_slot() { # SLOT CHAIN KEY (accepted)
	mkdir -p "$TLS_SLOTS_DIR/$1" && chmod 0700 "$TLS_DIR" "$TLS_SLOTS_DIR" "$TLS_SLOTS_DIR/$1" 2>/dev/null
	put_pair "$2" "$3" "$TLS_SLOTS_DIR/$1/fullchain.pem" "$TLS_SLOTS_DIR/$1/privkey.pem"
}
restore_slot() { restore_pair "$TLS_SLOTS_DIR/$1/fullchain.pem" "$TLS_SLOTS_DIR/$1/privkey.pem"; }

ensure_selfsigned() { # the fallback when no trusted pair exists: one key, a one-year certificate
	d=$TLS_SELF_DIR
	mkdir -p "$d" && chmod 0700 "$d"
	if [ ! -s "$d/privkey.pem" ]; then
		openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -pkeyopt ec_param_enc:named_curve -out "$d/privkey.pem.tmp" 2>/dev/null \
			&& chmod 0600 "$d/privkey.pem.tmp" && mv -f "$d/privkey.pem.tmp" "$d/privkey.pem" || return 1
		rm -f "$d/fullchain.pem"
	fi
	if [ -s "$d/fullchain.pem" ] && [ "$(cert_date "$d/fullchain.pem" enddate)" -gt "$(now)" ]; then return 0; fi
	san=$(for n in $(slot_names current); do printf 'DNS:%s,' "$n"; done | sed 's/,$//')
	openssl req -x509 -new -key "$d/privkey.pem" -subj "/CN=$DEVICE_HOST" -days 365 \
		-addext "subjectAltName=$san" -addext "keyUsage=critical,digitalSignature" -addext "extendedKeyUsage=serverAuth" \
		-addext "basicConstraints=critical,CA:FALSE" -out "$d/fullchain.pem.tmp" 2>/dev/null \
		&& chmod 0644 "$d/fullchain.pem.tmp" && sync && mv -f "$d/fullchain.pem.tmp" "$d/fullchain.pem"
}

active_slot() { # the slot active.json names (default current)
	s=""
	[ -r "$ACTIVE_FILE" ] && s=$(sed -n 's/.*"slot"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$ACTIVE_FILE" | head -n1)
	valid_slot "$s" && echo "$s" || echo current
}
served_slot() { s=""; [ -r "$SERVED_FILE" ] && s=$(tr -dc a-z <"$SERVED_FILE"); echo "${s:-none}"; }

# serve: pick the pair nginx serves and swap it in. 0 = served (changed or not), 1 = nginx -t failed
SERVED_CHANGED=0
cmd_select() {
	SERVED_CHANGED=0
	a=$(active_slot); o=$(other_slot "$a"); pick=""
	for s in $a $o; do
		if pair_usable "$s" "$TLS_SLOTS_DIR/$s"; then pick=$s; break; fi
	done
	if [ -n "$pick" ]; then
		src="$TLS_SLOTS_DIR/$pick"
		[ "$pick" = "$a" ] || log "active slot $a has no usable pair here: serving $pick"
	else
		ensure_selfsigned || { log "self-signed fallback could not be made"; return 1; }
		src=$TLS_SELF_DIR; pick=selfsigned
	fi
	if cmp -s "$src/fullchain.pem" "$TLS_CERT" && cmp -s "$src/privkey.pem" "$TLS_KEY"; then
		[ "$(served_slot)" = "$pick" ] || printf '%s\n' "$pick" >"$SERVED_FILE"
		return 0
	fi
	mkdir -p "$TLS_DIR" && chmod 0700 "$TLS_DIR"
	put_pair "$src/fullchain.pem" "$src/privkey.pem" "$TLS_CERT" "$TLS_KEY" || { log "could not write $TLS_CERT / $TLS_KEY"; return 1; }
	if ! nginx_config_ok; then
		if [ -s "$TLS_CERT.prev" ] && [ -s "$TLS_KEY.prev" ]; then
			log "nginx -t failed with the $pick pair: restoring the previous one"
			restore_pair "$TLS_CERT" "$TLS_KEY"
			reload_nginx
			REASON="nginx -t failed; previous certificate restored"
			return 1
		fi
		log "nginx -t failed, and there was no previous pair to go back to: keeping the $pick pair"
	fi
	rm -f "$TLS_CERT.prev" "$TLS_KEY.prev"
	printf '%s\n' "$pick" >"$SERVED_FILE.tmp" && mv -f "$SERVED_FILE.tmp" "$SERVED_FILE"
	SERVED_CHANGED=1
	log "serving the $pick pair (notAfter $(openssl x509 -in "$TLS_CERT" -noout -enddate 2>/dev/null | cut -d= -f2-))"
	reload_nginx
	return 0
}

# ---------------------------------------------------------------- state file (read by api.py)

slot_json() { # SLOT -> {"notAfter": N, "usable": bool}
	d="$TLS_SLOTS_DIR/$1"; na=0; u=false
	if [ -s "$d/fullchain.pem" ]; then na=$(cert_date "$d/fullchain.pem" enddate); pair_usable "$1" "$d" && u=true; fi
	printf '{"notAfter": %s, "usable": %s}' "${na:-0}" "$u"
}
state_num() { [ -r "$TLS_STATE" ] && sed -n "s/.*\"$1\": *\([0-9]*\).*/\1/p" "$TLS_STATE" | head -n1; }
state_word() { [ -r "$TLS_STATE" ] && sed -n "s/.*\"$1\": *\"\([a-z]*\)\".*/\1/p" "$TLS_STATE" | head -n1; }
# set by cmd_fetch for write_state: CHECK_SRC dns|full (a check ran), CHANGE_NOW 1 (a slot,
# active.json or the served pair changed), FULL_NOW 1 (the full download ran)
CHECK_SRC="" CHANGE_NOW=0 FULL_NOW=0
write_state() { # result message
	result=$1; msg=$(json_str "$2")
	st_dir=$(dirname "$TLS_STATE")
	mkdir -p "$st_dir" && chmod 0755 "$st_dir"
	t=$(now)
	prev_success=$(state_num lastSuccess)
	case "$result" in installed|unchanged|pending) prev_success=$t ;; esac
	last_check=$(state_num lastCheck); last_change=$(state_num lastChange); last_full=$(state_num lastFullFetch)
	check_src=$(state_word checkSource)
	if [ -n "$CHECK_SRC" ]; then last_check=$t; check_src=$CHECK_SRC; fi
	if [ "$CHANGE_NOW" = 1 ] || [ "$SERVED_CHANGED" = 1 ]; then last_change=$t; fi
	[ "$FULL_NOW" = 1 ] && last_full=$t
	nb=0; na=0; trusted=false; self=false; issuer=""; chain_sha=""; spki=""
	served=$(served_slot)
	if [ -s "$TLS_CERT" ]; then
		nb=$(cert_date "$TLS_CERT" startdate); na=$(cert_date "$TLS_CERT" enddate)
		is_trusted_chain "$TLS_CERT" && trusted=true
		mktmp; first_cert "$TLS_CERT" >"$TMP/s-leaf.pem"
		[ "$(openssl x509 -in "$TMP/s-leaf.pem" -noout -subject 2>/dev/null | cut -d= -f2-)" = "$(openssl x509 -in "$TMP/s-leaf.pem" -noout -issuer 2>/dev/null | cut -d= -f2-)" ] && self=true
		issuer=$(json_str "$(openssl x509 -in "$TMP/s-leaf.pem" -noout -issuer 2>/dev/null | cut -d= -f2-)")
		chain_sha=$(sha256_stdin <"$TLS_CERT"); spki=$(spki_of_cert "$TMP/s-leaf.pem")
	fi
	tmp="$TLS_STATE.tmp"
	printf '{"host": "%s", "slot": "%s", "activeSlot": "%s", "notBefore": %s, "notAfter": %s, "trusted": %s, "selfSigned": %s, "issuer": "%s", "chainSha256": "%s", "spkiSha256": "%s", "slots": {"current": %s, "standby": %s}, "lastAttempt": %s, "lastResult": "%s", "lastMessage": "%s", "lastSuccess": %s, "lastCheck": %s, "lastChange": %s, "checkSource": "%s", "lastFullFetch": %s, "pointer": "%s", "baseUrl": "%s"}\n' \
		"$(json_str "$DEVICE_HOST")" "$served" "$(active_slot)" "${nb:-0}" "${na:-0}" "$trusted" "$self" "$issuer" "$chain_sha" "$spki" \
		"$(slot_json current)" "$(slot_json standby)" "$t" "$result" "$msg" "${prev_success:-0}" \
		"${last_check:-0}" "${last_change:-0}" "$check_src" "${last_full:-0}" "$(json_str "$TLS_POINTER_NAME")" "$(json_str "$TLS_BASE_URL")" >"$tmp" \
		&& chmod 0644 "$tmp" && mv -f "$tmp" "$TLS_STATE"
}

# ---------------------------------------------------------------- commands

cmd_init() {
	mkdir -p "$TLS_DIR" && chmod 0700 "$TLS_DIR"
	# an install from the per-device design: a served pair for the four names that is still good
	# becomes the current slot instead of being thrown away
	if [ ! -s "$TLS_SLOTS_DIR/current/fullchain.pem" ] && [ -s "$TLS_CERT" ] && [ -s "$TLS_KEY" ]; then
		check_pair current "$TLS_CERT" "$TLS_KEY" 2>/dev/null
		case $? in 0|2) install_slot current "$TLS_CERT" "$TLS_KEY" && log "kept the served pair as the current slot" ;; esac
	fi
	if [ -d "$TLS_BUNDLE_DIR" ]; then
		for s in $SLOTS; do
			b="$TLS_BUNDLE_DIR/$s"
			[ -s "$b/fullchain.pem" ] && [ -s "$b/privkey.pem" ] || continue
			accept_pair "$s" "$b/fullchain.pem" "$b/privkey.pem"; rc=$?
			case $rc in
				0) install_slot "$s" "$b/fullchain.pem" "$b/privkey.pem" && log "installed the bundled $s pair" ;;
				3) ;;
				2) # clock not set: a bundled pair that passed every other check beats having none
					if [ ! -s "$TLS_SLOTS_DIR/$s/fullchain.pem" ]; then
						install_slot "$s" "$b/fullchain.pem" "$b/privkey.pem" && log "installed the bundled $s pair (clock not set yet)"
					fi ;;
				*) log "bundled $s pair not used: $REASON" ;;
			esac
		done
		if [ ! -s "$ACTIVE_FILE" ] && [ -s "$TLS_BUNDLE_DIR/active.json" ] && [ "$(fsize "$TLS_BUNDLE_DIR/active.json")" -le 4096 ]; then
			cp "$TLS_BUNDLE_DIR/active.json" "$ACTIVE_FILE.tmp" && chmod 0644 "$ACTIVE_FILE.tmp" && mv -f "$ACTIVE_FILE.tmp" "$ACTIVE_FILE"
		fi
	fi
	cmd_select || { write_state failed "${REASON:-could not serve a certificate}"; return 1; }
	[ -s "$TLS_STATE" ] || write_state init "serving the $(served_slot) pair"
	return 0
}

download() { # URL OUT LIMIT
	curl -fsS --proto '=https' --tlsv1.2 --cacert "$TLS_CAFILE" --max-filesize "$3" \
		--connect-timeout 15 --max-time 60 --retry 0 -o "$2" "$1" 2>"$TMP/curl.err" || {
		DL_ERR=$(head -c 200 "$TMP/curl.err" | tr '\n' ' '); return 1; }
	[ "$(fsize "$2")" -le "$3" ] || { DL_ERR="larger than $3 bytes"; return 1; }
}

# ---------------------------------------------------------------- the version pointer (DNS)
# The answer is untrusted by design (see the header): it only decides whether to download, and every
# downloaded file still passes accept_pair. Never resolved through the local dnsmasq, which owns the
# car names: the resolvers are asked directly.

with_timeout() { # SECONDS CMD...: busybox and coreutils both have timeout(1); without it, run plainly
	if command -v timeout >/dev/null 2>&1; then timeout "$@"; else shift; "$@"; fi
}
# zone-file TXT data lines on stdin -> the record texts (character strings joined, quoting removed)
txt_text() { sed -n 's/^[^"]*\(".*"\)[[:space:]]*$/\1/p' | sed 's/" "//g' | tr -d '"\\' | cut -c1-512 | head -n 8; }

# pointer_txt: the TXT texts of TLS_POINTER_NAME on stdout; PTR_VIA says how they were obtained,
# PTR_ERR why there are none. delv is preferred: it validates DNSSEC itself. Its verbose output is
# parsed (not +short) because the trust comment ("; fully validated") is only printed there.
PTR_VIA="" PTR_ERR=""
pointer_txt() {
	PTR_VIA="" PTR_ERR="no resolver answered"
	command -v delv >/dev/null 2>&1 || command -v dig >/dev/null 2>&1 \
		|| { PTR_ERR="neither delv nor dig is installed (Debian: bind9-dnsutils, Alpine: bind-tools)"; return 1; }
	for r in $TLS_DNS_RESOLVERS; do
		if command -v delv >/dev/null 2>&1; then
			out=$(with_timeout 10 delv @"$r" TXT "$TLS_POINTER_NAME" 2>&1)
			txt=$(printf '%s\n' "$out" | grep -v '^;' | grep "[[:space:]]IN[[:space:]][[:space:]]*TXT[[:space:]]" | txt_text)
			if [ -n "$txt" ]; then
				case "$out" in
					*"; fully validated"*) PTR_VIA="delv @$r, DNSSEC validated" ;;
					*) PTR_VIA="delv @$r, not validated (unsigned zone)" ;;
				esac
				printf '%s\n' "$txt"; return 0
			fi
			PTR_ERR="delv @$r: $(printf '%s\n' "$out" | grep -v '^$' | head -n1 | cut -c1-120)"
		fi
		if command -v dig >/dev/null 2>&1; then
			out=$(dig +short +time=3 +tries=2 TXT "$TLS_POINTER_NAME" @"$r" 2>&1)
			txt=$(printf '%s\n' "$out" | grep '^"' | txt_text)
			if [ -n "$txt" ]; then PTR_VIA="dig @$r, not validated"; printf '%s\n' "$txt"; return 0; fi
			out=$(printf '%s\n' "$out" | grep -v '^$' | head -n1 | cut -c1-120)
			PTR_ERR="dig @$r: ${out:-no TXT record}"
		fi
	done
	return 1
}

ptr_hash_ok() { # a full sha256 in lower-case hex, or "-" (not published)
	[ "$1" = - ] && return 0
	[ "${#1}" -eq 64 ] || return 1
	case "$1" in *[!0-9a-f]*) return 1 ;; esac
}
# pointer_parse TEXT: sets PTR_ACTIVE, PTR_CURRENT, PTR_STANDBY, PTR_T; 1 = malformed (PTR_ERR)
pointer_parse() {
	PTR_ACTIVE="" PTR_CURRENT="" PTR_STANDBY="" PTR_T="" pv=""
	recs=$(printf '%s\n' "$1" | grep '^v=' | sort -u)
	[ -n "$recs" ] || { PTR_ERR="no v= record"; return 1; }
	[ "$(printf '%s\n' "$recs" | wc -l | tr -d ' ')" = 1 ] || { PTR_ERR="more than one pointer record"; return 1; }
	set -f
	for w in $recs; do
		case "$w" in
			v=*) pv=${w#v=} ;;
			active=*) PTR_ACTIVE=${w#active=} ;;
			current=*) PTR_CURRENT=${w#current=} ;;
			standby=*) PTR_STANDBY=${w#standby=} ;;
			t=*) PTR_T=${w#t=} ;;
		esac
	done
	set +f
	[ "$pv" = 1 ] || { PTR_ERR="not a v=1 pointer"; return 1; }
	valid_slot "$PTR_ACTIVE" || { PTR_ERR="active slot '$(json_str "$PTR_ACTIVE")' unknown"; return 1; }
	ptr_hash_ok "$PTR_CURRENT" || { PTR_ERR="current= is not a sha256 or -"; return 1; }
	ptr_hash_ok "$PTR_STANDBY" || { PTR_ERR="standby= is not a sha256 or -"; return 1; }
	case "$PTR_T" in ''|*[!0-9]*) PTR_ERR="t= is not a unix time"; return 1 ;; esac
	return 0
}
pointer_print() { printf 'active=%s current=%s standby=%s t=%s\n' "$PTR_ACTIVE" "$PTR_CURRENT" "$PTR_STANDBY" "$PTR_T"; }
ptr_want() { if [ "$1" = standby ]; then echo "$PTR_STANDBY"; else echo "$PTR_CURRENT"; fi; }

# a published pair this Pi rejected is not downloaded again for TLS_FETCH_INTERVAL (an older pair
# put back on purpose, a trust store that lacks the root: the pointer would ask for it every hour)
rejected_file() { echo "$(dirname "$TLS_STATE")/rejected-$1"; }
remember_rejected() { # SLOT SHA
	mkdir -p "$(dirname "$TLS_STATE")" && printf '%s %s\n' "$2" "$(now)" >"$(rejected_file "$1")"
}
rejected_recently() { # SLOT SHA
	f=$(rejected_file "$1")
	[ -r "$f" ] || return 1
	read -r rsha rt <"$f" || return 1
	[ "$rsha" = "$2" ] && [ $(( $(now) - ${rt:-0} )) -lt "$TLS_FETCH_INTERVAL" ]
}

# may the full download run now? Always when no trusted pair is served; else every TLS_FETCH_INTERVAL
full_allowed() {
	case "$(served_slot)" in current|standby) ;; *) return 0 ;; esac
	last=$(state_num lastFullFetch)
	[ $(( $(now) - ${last:-0} )) -ge "$TLS_FETCH_INTERVAL" ]
}
# the served certificate has less than a quarter of its lifetime left (the issuer renews at a third)
served_nearly_expired() {
	case "$(served_slot)" in current|standby) ;; *) return 1 ;; esac
	[ -s "$TLS_CERT" ] || return 1
	nb=$(cert_date "$TLS_CERT" startdate); na=$(cert_date "$TLS_CERT" enddate)
	[ -n "$nb" ] && [ -n "$na" ] || return 1
	[ $(( (na - $(now)) * 4 )) -lt $(( na - nb )) ]
}

# ---------------------------------------------------------------- fetch

addnote() { FETCH_NOTES="${FETCH_NOTES:+$FETCH_NOTES; }$*"; }
fetch_reset() { FETCH_NOTES="" FETCH_CHANGED="" FETCH_GOOD=0 FETCH_DLFAIL=0 FETCH_REJECTED=0 FETCH_DEFERRED=0 FETCH_PENDING=0 ACTIVE_CHANGED=0; }
fetch_reset

fetch_active() { # [WANT]: download active.json and take it; with WANT, only when it names WANT
	fa_want=${1:-}
	if ! download "$TLS_BASE_URL/active.json" "$TMP/active.json" 4096; then
		FETCH_DLFAIL=1; addnote "active.json: download failed: $DL_ERR"; return
	fi
	fa=$(sed -n 's/.*"slot"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$TMP/active.json" | head -n1)
	if ! valid_slot "$fa"; then addnote "active.json names no slot (kept $(active_slot))"; return; fi
	if [ -n "$fa_want" ] && [ "$fa" != "$fa_want" ]; then
		FETCH_PENDING=1; addnote "active.json still names $fa, the pointer $fa_want: not published yet, kept $(active_slot)"; return
	fi
	if ! cmp -s "$TMP/active.json" "$ACTIVE_FILE"; then
		fa_old=$(active_slot)
		cp "$TMP/active.json" "$ACTIVE_FILE.tmp" && chmod 0644 "$ACTIVE_FILE.tmp" && mv -f "$ACTIVE_FILE.tmp" "$ACTIVE_FILE"
		[ "$fa_old" = "$fa" ] || ACTIVE_CHANGED=1
	fi
	addnote "active $fa"
}

fetch_slot() { # SLOT [WANT_SHA]: download the pair, check it, install it; with WANT_SHA, only that chain
	fs=$1 fs_want=${2:-}
	if ! download "$TLS_BASE_URL/$fs/fullchain.pem" "$TMP/$fs.chain" "$TLS_MAX_BYTES" \
		|| ! download "$TLS_BASE_URL/$fs/privkey.pem" "$TMP/$fs.key" "$TLS_MAX_BYTES"; then
		FETCH_DLFAIL=1; addnote "$fs: download failed: $DL_ERR"; log "$fs: download failed: $DL_ERR"; return
	fi
	fs_sha=$(sha256_stdin <"$TMP/$fs.chain")
	if [ -n "$fs_want" ] && [ "$fs_sha" != "$fs_want" ]; then
		# the pointer is newer than what the CDN hands out (cached): not an error, nothing is downgraded
		FETCH_PENDING=1; addnote "$fs: the download is not the pointer's chain yet (not published or still cached): kept the installed pair"
		log "$fs: downloaded chain $fs_sha, the pointer names $fs_want: not published yet"
		return
	fi
	accept_pair "$fs" "$TMP/$fs.chain" "$TMP/$fs.key"; rc=$?
	case $rc in
		0) if install_slot "$fs" "$TMP/$fs.chain" "$TMP/$fs.key"; then
				FETCH_CHANGED="$FETCH_CHANGED $fs"; FETCH_GOOD=1; addnote "$fs: installed"
				rm -f "$(rejected_file "$fs")"
				log "$fs: installed a new pair (notAfter $(openssl x509 -in "$TMP/$fs.chain" -noout -enddate | cut -d= -f2-))"
			else
				addnote "$fs: could not be written"
			fi ;;
		3) FETCH_GOOD=1; addnote "$fs: unchanged" ;;
		2) FETCH_DEFERRED=1; addnote "$fs: deferred ($REASON)" ;;
		*) FETCH_REJECTED=1; addnote "$fs: rejected ($REASON)"; remember_rejected "$fs" "$fs_sha" ;;
	esac
}

fetch_full() {
	fetch_active
	for s in $SLOTS; do fetch_slot "$s"; done
}

NEED_FULL=""
fetch_by_pointer() { # after pointer_parse: download only what differs; sets NEED_FULL for the fallback
	log "pointer ($PTR_VIA): active=$PTR_ACTIVE current=$PTR_CURRENT standby=$PTR_STANDBY t=$PTR_T"
	addnote "pointer via $PTR_VIA"
	if [ "$PTR_ACTIVE" != "$(active_slot)" ]; then fetch_active "$PTR_ACTIVE"; else addnote "active $PTR_ACTIVE"; fi
	for s in $SLOTS; do
		want=$(ptr_want "$s") have=-
		[ -s "$TLS_SLOTS_DIR/$s/fullchain.pem" ] && have=$(sha256_stdin <"$TLS_SLOTS_DIR/$s/fullchain.pem")
		if [ "$want" = "$have" ] || [ "$want" = - ]; then
			[ "$want" = - ] && addnote "$s: not published" || addnote "$s: unchanged"
			if [ "$have" != - ] && pair_usable "$s" "$TLS_SLOTS_DIR/$s"; then FETCH_GOOD=1; fi
		elif rejected_recently "$s" "$want"; then
			FETCH_REJECTED=1; addnote "$s: the published pair was rejected here before, next try within ${TLS_FETCH_INTERVAL}s"
		else
			fetch_slot "$s" "$want"
		fi
	done
	if [ "$FETCH_PENDING" = 1 ]; then
		NEED_FULL="the pointer is ahead of the download"
	elif [ -z "$FETCH_CHANGED" ] && served_nearly_expired; then
		NEED_FULL="the served certificate has less than a quarter of its lifetime left and the pointer shows nothing newer"
	fi
}

fetch_finish() { # serve the best pair, write the state; exit status of fetch
	if ! cmd_select; then
		for s in $FETCH_CHANGED; do restore_slot "$s"; done
		cmd_select
		write_state failed "nginx -t failed; previous certificate restored ($FETCH_NOTES)"
		return 1
	fi
	if [ -n "$FETCH_CHANGED" ] || [ "$ACTIVE_CHANGED" = 1 ] || [ "$SERVED_CHANGED" = 1 ]; then CHANGE_NOW=1; fi
	served=$(served_slot)
	if [ "$FETCH_GOOD" = 1 ] && [ "$served" != selfsigned ]; then
		if [ -n "$FETCH_CHANGED" ] || [ "$SERVED_CHANGED" = 1 ]; then result=installed
		elif [ "$FETCH_PENDING" = 1 ]; then result=pending
		else result=unchanged; fi
		log "$result: serving $served ($FETCH_NOTES)"
		write_state "$result" "serving $served; $FETCH_NOTES"
		return 0
	fi
	if [ "$FETCH_REJECTED" = 1 ]; then result=rejected
	elif [ "$FETCH_DEFERRED" = 1 ]; then result=deferred
	elif [ "$FETCH_PENDING" = 1 ]; then result=pending
	else result=failed; fi
	log "$result: serving $served ($FETCH_NOTES)"
	write_state "$result" "serving $served; $FETCH_NOTES"
	return 1
}

cmd_fetch() { # [--full]
	[ -n "$TLS_BASE_URL" ] || { log "TLS_BASE_URL is empty: fetching is off"; cmd_select; write_state failed "TLS_BASE_URL not configured"; return 1; }
	case "$TLS_BASE_URL" in https://*) ;; *) log "TLS_BASE_URL must be https"; cmd_select; write_state failed "TLS_BASE_URL is not https"; return 1 ;; esac
	mkdir -p "$TLS_DIR" && chmod 0700 "$TLS_DIR"
	mktmp
	fetch_reset
	CHECK_SRC="" CHANGE_NOW=0 FULL_NOW=0 NEED_FULL=""
	if [ "${1:-}" = --full ]; then
		NEED_FULL="requested"
	elif [ -z "$TLS_POINTER_NAME" ]; then
		NEED_FULL="no pointer record (TLS_POINTER_NAME is empty)"
	elif pointer_txt >"$TMP/pointer.txt" && pointer_parse "$(cat "$TMP/pointer.txt")"; then
		CHECK_SRC=dns
		fetch_by_pointer
	else
		NEED_FULL="pointer $TLS_POINTER_NAME: $PTR_ERR"
	fi
	if [ -n "$NEED_FULL" ]; then
		if [ "${1:-}" != --full ] && ! full_allowed; then
			lf=$(state_num lastFullFetch)
			wait_s=$(( TLS_FETCH_INTERVAL - ($(now) - ${lf:-0}) ))
			if [ "$CHECK_SRC" = dns ]; then
				addnote "$NEED_FULL; full download in ${wait_s}s at the latest"
				fetch_finish; return $?
			fi
			# no answer and a trusted pair is served: nothing is written (the last result stands)
			log "$NEED_FULL; the last full download was less than ${TLS_FETCH_INTERVAL}s ago, the next one in ${wait_s}s at the latest"
			cmd_select || return 1
			return 0
		fi
		log "full download: $NEED_FULL"
		keep_changed=$FETCH_CHANGED keep_active=$ACTIVE_CHANGED
		fetch_reset
		FETCH_CHANGED=$keep_changed ACTIVE_CHANGED=$keep_active CHECK_SRC=full FULL_NOW=1
		addnote "full download ($NEED_FULL)"
		fetch_full
	fi
	fetch_finish
}

cmd_verify() { # SLOT CHAIN KEY: local check, no install
	accept_pair "$1" "$2" "$3"; rc=$?
	case $rc in
		0) echo "accept ($1)"; return 0 ;;
		3) echo "accept (unchanged)"; return 0 ;;
		2) echo "defer: $REASON"; return 2 ;;
		*) echo "reject: $REASON"; return 1 ;;
	esac
}

# crl-status CHAIN CRL: is the leaf's serial in this CRL? The CRL must be signed by the chain's
# issuer (the second certificate), name it as issuer and be current; otherwise "unknown".
cmd_crl_status() {
	mktmp
	first_cert "$1" >"$TMP/c-leaf.pem"
	rest_certs "$1" | awk '/-----BEGIN CERTIFICATE-----/{p=1} p{print} /-----END CERTIFICATE-----/{if(p) exit}' >"$TMP/c-issuer.pem"
	openssl x509 -in "$TMP/c-leaf.pem" -noout >/dev/null 2>&1 || { echo "unknown: leaf does not parse"; return 0; }
	[ -s "$TMP/c-issuer.pem" ] || { echo "unknown: no issuer certificate in the chain"; return 0; }
	form=DER; grep -q '^-----BEGIN X509 CRL-----' "$2" 2>/dev/null && form=PEM
	openssl crl -inform "$form" -in "$2" -noout -CAfile "$TMP/c-issuer.pem" >/dev/null 2>&1 \
		|| { echo "unknown: the CRL does not verify against the issuer"; return 0; }
	ci=$(openssl crl -inform "$form" -in "$2" -noout -issuer 2>/dev/null | cut -d= -f2-)
	li=$(openssl x509 -in "$TMP/c-leaf.pem" -noout -issuer 2>/dev/null | cut -d= -f2-)
	[ "$ci" = "$li" ] || { echo "unknown: the CRL's issuer is not the leaf's"; return 0; }
	nu=$(to_epoch "$(openssl crl -inform "$form" -in "$2" -noout -nextupdate 2>/dev/null | cut -d= -f2-)")
	if [ -n "$nu" ] && [ "$nu" -lt "$(now)" ]; then echo "unknown: the CRL is past its nextUpdate"; return 0; fi
	norm() { tr 'a-f' 'A-F' | sed 's/^0*//'; }
	serial=$(openssl x509 -in "$TMP/c-leaf.pem" -noout -serial | cut -d= -f2 | norm)
	if openssl crl -inform "$form" -in "$2" -noout -text 2>/dev/null | sed -n 's/^[[:space:]]*Serial Number:[[:space:]]*//p' | norm | grep -qxF "$serial"; then
		echo "revoked"
	else
		echo "good"
	fi
}

# ---------------------------------------------------------------- daemon

WAKE=0
cmd_daemon() {
	echo $$ >"$PIDFILE"
	trap 'WAKE=1; [ -n "${SLEEPER:-}" ] && kill "$SLEEPER" 2>/dev/null' USR1
	trap 'rm -f "$PIDFILE"; cleanup; exit 0' TERM INT
	cmd_init || true
	fail_delay=60
	delay=$((5 + $(random_below 55)))   # boot: soon, but not in lockstep with every other service
	last_ok=0
	while :; do
		SLEEPER=""
		if [ "$delay" -gt 0 ]; then
			sleep "$delay" & SLEEPER=$!
			wait "$SLEEPER" 2>/dev/null
			kill "$SLEEPER" 2>/dev/null
		fi
		if [ "$WAKE" = 1 ] && [ $(( $(now) - last_ok )) -lt 600 ]; then
			WAKE=0; delay=$TLS_CHECK_INTERVAL; continue  # just succeeded; an uplink flap is no reason
		fi
		WAKE=0
		if cmd_fetch; then
			last_ok=$(now); fail_delay=60
			delay=$(( TLS_CHECK_INTERVAL - TLS_CHECK_INTERVAL / 10 + $(random_below $(( TLS_CHECK_INTERVAL / 5 + 1 ))) ))
		else
			delay=$(( fail_delay + $(random_below $(( fail_delay / 4 + 1 ))) ))
			fail_delay=$(( fail_delay * 2 )); [ "$fail_delay" -gt "$TLS_CHECK_INTERVAL" ] && fail_delay=$TLS_CHECK_INTERVAL
			log "next attempt in ${delay}s"
		fi
	done
}

cmd_kick() {
	last=0
	[ -r "$TLS_STATE" ] && last=$(sed -n 's/.*"lastSuccess": *\([0-9]*\).*/\1/p' "$TLS_STATE" | head -n1)
	if [ $(( $(now) - ${last:-0} )) -lt "$TLS_KICK_MIN_AGE" ]; then
		return 0  # fetched a moment ago; an uplink flap is no reason to ask again
	fi
	if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
		systemctl start --no-block "$FETCH_UNIT" 2>/dev/null && return 0
	fi
	[ -s "$PIDFILE" ] && kill -USR1 "$(cat "$PIDFILE")" 2>/dev/null
	return 0
}

case "${1:-}" in
	init|fetch|select|verify|crl-status|daemon)
		[ -n "$DEVICE_HOST" ] || { echo "teslalinux-tls: DEVICE_HOST missing (in $ENV_FILE or the environment)" >&2; exit 2; } ;;
esac
case "${1:-}" in
	init) cmd_init ;;
	fetch)
		case "${2:-}" in ''|--full) ;; *) echo "usage: teslalinux-tls fetch [--full]" >&2; exit 2 ;; esac
		cmd_fetch "${2:-}" ;;
	pointer)
		if [ $# -ge 2 ]; then
			pointer_parse "$2" || { echo "malformed: $PTR_ERR"; exit 1; }
		else
			[ -n "$TLS_POINTER_NAME" ] || { echo "no pointer: TLS_POINTER_NAME is empty (or DEVICE_HOST has no parent domain)"; exit 1; }
			mktmp
			{ pointer_txt >"$TMP/pointer.txt" && pointer_parse "$(cat "$TMP/pointer.txt")"; } || { echo "$TLS_POINTER_NAME: $PTR_ERR"; exit 1; }
			echo "$TLS_POINTER_NAME ($PTR_VIA)"
		fi
		pointer_print ;;
	select) cmd_select && write_state selected "serving the $(served_slot) pair" ;;
	verify) [ $# -eq 4 ] || { echo "usage: teslalinux-tls verify current|standby CHAIN KEY" >&2; exit 2; }; cmd_verify "$2" "$3" "$4" ;;
	crl-status) [ $# -eq 3 ] || { echo "usage: teslalinux-tls crl-status CHAIN CRL" >&2; exit 2; }; cmd_crl_status "$2" "$3" ;;
	daemon) cmd_daemon ;;
	kick) cmd_kick ;;
	status) cat "$TLS_STATE" 2>/dev/null || echo "no state yet" ;;
	*) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 2 ;;
esac
