[Unit]
Description=teslalinux: Waydroid headless session on tacomp's Wayland socket
After=waydroid-container.service tacomp.service teslalinux-pipewire-pulse.service
Requires=waydroid-container.service tacomp.service

[Service]
User=tesla
Group=tesla
Environment=XDG_RUNTIME_DIR=/run/tesla
Environment=WAYLAND_DISPLAY=tesla-0
Environment=PULSE_SERVER=unix:/run/tesla/pulse/native
# Wait for the compositor socket, then start the session (blocks while the session runs).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/tesla/tesla-0 ] && exit 0; sleep 0.1; done; exit 1'
ExecStart=/usr/bin/waydroid session start
ExecStop=/usr/bin/waydroid session stop
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
