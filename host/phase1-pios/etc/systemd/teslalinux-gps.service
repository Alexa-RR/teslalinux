[Unit]
Description=teslalinux: browser geolocation WebSocket (9998) -> location feed (9997)

[Service]
User=tesla
Environment=TESLALINUX_GPS_WS_PORT=9998
Environment=TESLALINUX_GPS_WS_BIND=127.0.0.1
Environment=TESLALINUX_GPS_FEED_PORT=9997
# the app (ATL, same host) reads the feed on loopback
Environment=TESLALINUX_GPS_FEED_BIND=127.0.0.1
ExecStart=/usr/bin/python3 /usr/local/lib/teslalinux/gps.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
