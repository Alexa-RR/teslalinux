[Unit]
Description=teslalinux: PipeWire for the tesla user in /run/tesla (the "android" null sink the app plays into)
After=local-fs.target

[Service]
User=tesla
Group=tesla
Environment=XDG_RUNTIME_DIR=/run/tesla
Environment=HOME=/var/lib/tesla
ExecStart=/usr/bin/pipewire
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
