[Unit]
Description=teslalinux: D-Bus session bus for the tesla user in /run/tesla (ATL's GTK/libportal need one: xdp_portal_new() aborts the app without it)
# A session bus is what a desktop login would give the app. The car has no login session, so the
# bus lives with the other per-user daemons in /run/tesla, next to tacomp's Wayland socket and PipeWire.
After=local-fs.target
Before=teslalinux-atl.service

[Service]
User=tesla
Group=tesla
Environment=XDG_RUNTIME_DIR=/run/tesla
Environment=HOME=/var/lib/tesla
ExecStartPre=-/bin/rm -f /run/tesla/bus
ExecStart=/usr/bin/dbus-daemon --session --nofork --nopidfile --address=unix:path=/run/tesla/bus
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
