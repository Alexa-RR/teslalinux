# teslalinux settings: /etc/teslalinux/env on the car (Pi OS provision.sh and the Alpine image both
# install this file and render every host config from it with host/teslalinux-render). Edit before
# building or provisioning.

# Hostname the car's browser will open: the same for every teslalinux car, with a shared publicly
# trusted certificate (see TLS_BASE_URL below). Its public DNS A record points at HIJACK_IP. Change it
# only together with TLS_BASE_URL when you run your own certificate issuer.
DEVICE_HOST=car.alexahub.dev
# Public IP that dnsmasq hands out for DEVICE_HOST on the hotspot; nftables DNATs it to the Pi.
# It only needs to be non-RFC1918 (the car blocks private IPs); 192.0.2.1 is TEST-NET-1, never routed,
# so a car on another network can never reach a stranger's server under our name. The public A
# record of DEVICE_HOST points at the same address (DNS-01 issuance does not need it reachable).
HIJACK_IP=192.0.2.1
# Hotspot
AP_IFACE=wlan0
AP_SSID=Teslalinux
AP_PSK=changeit
AP_COUNTRY=US
AP_CHANNEL=44          # 5 GHz. Use 1-11 with HW_MODE=g for 2.4 GHz.
AP_HW_MODE=a
AP_SUBNET=172.16.0
# Android display
DISPLAY_W=1088
DISPLAY_H=832
DISPLAY_FPS=60
DISPLAY_DENSITY=200
# Waydroid image flavour: GAPPS (needed for Waze) or VANILLA
WAYDROID_SYSTEM_TYPE=GAPPS
# Offline mode (upstream persist.tesla-android.offline-mode.*; defaults from upstream vendor.mk, the
# frontend's Network settings override them, applied at the next boot):
#   OFFLINE_MODE=1                     answer Tesla's connectivity probes here so the car keeps the Wi-Fi
#   OFFLINE_MODE_TELEMETRY=1           1 = telemetry allowed; 0 = Tesla's telemetry hosts are blackholed
#   OFFLINE_MODE_FIRMWARE_DOWNLOADS=1  1 = firmware downloads allowed; 0 = va.teslamotors.com blackholed
OFFLINE_MODE=1
OFFLINE_MODE_TELEMETRY=1
OFFLINE_MODE_FIRMWARE_DOWNLOADS=1
# Certificate. Every car shares one publicly trusted certificate for DEVICE_HOST and its www./
# fullscreen. names, issued and renewed by .github/workflows/tls-certs.yml and published (chain and
# key, in two slots, current and standby, plus active.json) at TLS_BASE_URL. teslalinux-tls fetches
# both slots, checks them (trusted chain, exact names, key matches, current, newer) and makes nginx
# serve TLS_CERT/TLS_KEY from the slot active.json names. A release carries the pairs of its build
# day, so a new install works offline. Self-hosting: your own DEVICE_HOST and your own issuer's
# TLS_BASE_URL. No DNS or ACME credentials on the Pi. See docs/CAR-STACK-READINESS.md "Certificate".
TLS_CERT=/etc/teslalinux/tls/fullchain.pem
TLS_KEY=/etc/teslalinux/tls/privkey.pem
TLS_BASE_URL=https://certs.alexahub.dev/car
