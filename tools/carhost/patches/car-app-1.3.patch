+
+    // Car API level 5 (androidx car-app 1.3). This host has no alert UI: an alert is cancelled
+    // at once with AlertCallback.REASON_NOT_SUPPORTED, as the library defines for such a host.
+    @Override
+    public void showAlert(Bundleable alertBundleable) {
+      final androidx.car.app.model.Alert alert;
+      try {
+        alert = (androidx.car.app.model.Alert) alertBundleable.get();
+      } catch (BundlerException e) {
+        L.e(LogTags.TEMPLATE, e, "Could not read the alert");
+        return;
+      }
+      L.i(LogTags.TEMPLATE, "Alert %d: not supported by this host", alert.getId());
+      alert
+          .getCallbackDelegate()
+          .sendCancel(
+              androidx.car.app.model.AlertCallback.REASON_NOT_SUPPORTED,
+              new androidx.car.app.OnDoneCallback() {});
+    }
+
+    // No alert is ever shown (see showAlert), so there is none to dismiss.
+    @Override
+    public void dismissAlert(int alertId) {
+      L.d(LogTags.TEMPLATE, "dismissAlert %d: no alert is shown", alertId);
+    }
+
+    // This host offers no microphone to apps: no response (the library reports that the
+    // microphone could not be opened).
+    @Override
+    @androidx.annotation.Nullable
+    public Bundleable openMicrophone(Bundleable openMicrophoneRequest) {
+      L.w(LogTags.TEMPLATE, "openMicrophone: this host has no microphone for apps");
+      return null;
+    }
   }
 }
