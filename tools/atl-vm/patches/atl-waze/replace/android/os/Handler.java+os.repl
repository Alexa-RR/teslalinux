	/** AOSP: the binder behind Messengers of this Handler. */
	private final class MessengerImpl extends IMessenger.Stub {
		public void send(Message msg) {
			msg.sendingUid = Binder.getCallingUid();
			Handler.this.sendMessage(msg);
		}
	}
