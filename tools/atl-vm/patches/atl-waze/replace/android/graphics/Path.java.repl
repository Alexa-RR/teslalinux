	/** AOSP: true if the path contains no lines or curves (a geometric test, not "never touched"). */
	public boolean isEmpty() {
		if (path == 0 && builder == 0)
			return true;
		return native_is_empty(getGskPath());
	}
	private static native boolean native_is_empty(long path);
