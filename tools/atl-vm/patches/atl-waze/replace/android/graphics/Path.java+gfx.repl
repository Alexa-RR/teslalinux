	public void transform(Matrix matrix, Path out_path) {
		if (out_path == null)
			out_path = this;

		out_path.transform(matrix);
	}
===
	/** AOSP: the transformed path goes into dst (this path is unchanged), or into this path if dst is null. */
	public void transform(Matrix matrix, Path out_path) {
		if (out_path == null || out_path == this) {
			transform(matrix);
			return;
		}
		out_path.set(this);
		out_path.transform(matrix);
	}
