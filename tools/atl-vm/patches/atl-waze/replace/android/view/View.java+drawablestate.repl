===
	public void setEnabled(boolean enabled) {
		if (atl_enabled == enabled)
			return;
		atl_enabled = enabled;
		native_setVisibility(widget, visibility, alpha, atl_enabled);
		// AOSP: a disabled view is not pressed, and state_enabled changes
		if (!enabled && pressed)
			setPressed(false);
		refreshDrawableState();
		invalidate();
	}
