	public void setSelected(boolean selected) {}
===
	/** AOSP: the selected state (tabs, segmented controls, list rows), passed on to a group's children */
	public void setSelected(boolean selected) {
		if (tlSelected != selected) {
			tlSelected = selected;
			if (!selected && pressed)
				setPressed(false);
			invalidate();
			refreshDrawableState();
			dispatchSetSelected(selected);
		}
	}
