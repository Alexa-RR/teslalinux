	/** AOSP: the background's tint list (kept across setBackground*), applied through applyBackgroundTint(). */
	public void setBackgroundTintList(ColorStateList tint) {
		tlBgTintList = tint;
		tlHasBgTintList = true;
		applyBackgroundTint();
	}
