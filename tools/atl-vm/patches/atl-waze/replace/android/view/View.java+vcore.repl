===
	/**
	 * AOSP: a drawable of this view changed: its dirty bounds are invalidated (the parent chain
	 * learns it, so a parent that records its children, such as Compose's AndroidViewHolder, records
	 * again) and the outline may follow the drawable. The GTK widget is redrawn in any case, since
	 * ATL views that draw a drawable natively do not all list it in verifyDrawable.
	 */
	public void invalidateDrawable(Drawable drawable) {
		nativeInvalidate(widget);
		if (verifyDrawable(drawable)) {
			final android.graphics.Rect dirty = drawable.getDirtyBounds();
			final int sx = getScrollX(), sy = getScrollY();
			invalidate(dirty.left + sx, dirty.top + sy, dirty.right + sx, dirty.bottom + sy);
			tlRebuildOutline();
		}
	}

	/**
	 * AOSP: the drawable's frame runs at the given uptime; the drawable is the token, so that
	 * unscheduleDrawable(who) removes every pending frame of it (AOSP posts to the Choreographer's
	 * animation queue with the drawable as token; here the view's main-thread handler).
	 */
	public void scheduleDrawable(Drawable drawable, Runnable runnable, long time) {
		if (verifyDrawable(drawable) && runnable != null)
			tlMainHandler().postAtTime(runnable, drawable, time);
	}

	public void unscheduleDrawable(Drawable drawable, Runnable runnable) {
		if (verifyDrawable(drawable) && runnable != null)
			tlMainHandler().removeCallbacks(runnable, drawable);
	}

	public void unscheduleDrawable(Drawable drawable) {
		if (drawable != null)
			tlMainHandler().removeCallbacksAndMessages(drawable);
	}
