		if (p instanceof View) {
			final View vp = (View) p;
			vp.transformMatrixToGlobal(matrix);
			matrix.preTranslate(-vp.getScrollX(), -vp.getScrollY());
		}
		matrix.preTranslate(getLeft(), getTop());
		matrix.preConcat(getMatrix());
	}
