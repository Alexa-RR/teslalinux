		public LayoutParams(int w, int h, int _type, int _flags, int _format) {
			super(w, h);
			type = _type;
			flags = _flags;
			format = _format;
		}

		public LayoutParams(int w, int h, int xpos, int ypos, int _type, int _flags, int _format) {
			super(w, h);
			x = xpos;
			y = ypos;
			type = _type;
			flags = _flags;
			format = _format;
