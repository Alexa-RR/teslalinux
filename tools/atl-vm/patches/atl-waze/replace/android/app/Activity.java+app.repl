	public final void dismissDialog(int id) {
		Dialog dialog = dialogs.get(id);
		if (dialog == null)
			throw new IllegalArgumentException("no dialog with id " + id + " was ever shown via Activity#showDialog");
		dialog.dismiss();
	}
