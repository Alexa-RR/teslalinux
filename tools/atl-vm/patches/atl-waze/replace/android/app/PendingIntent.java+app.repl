===
	public static PendingIntent getForegroundService(Context context, int requestCode, Intent intent, int flags) {
		PendingIntent pi = getService(context, requestCode, intent, flags);
		if (pi != null)
			pi.tlForegroundService = true;
		return pi;
	}
