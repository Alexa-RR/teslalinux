	/** AOSP: whether the image is clipped to the padding (teslalinux +text) */
	public void setCropToPadding(boolean crop) {
		if (mCropToPaddingFlag != crop) {
			mCropToPaddingFlag = crop;
			native_setCropToPadding(widget, crop);
			requestLayout();
			invalidate();
		}
	}
