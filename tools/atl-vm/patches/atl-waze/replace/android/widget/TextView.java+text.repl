===
	protected void tlUpdateCompoundPadding() {
		/* AOSP compound paddings include the view padding, which GTK applies as CSS padding */
		int l = getCompoundPaddingLeft() - getPaddingLeft();
		int r = getCompoundPaddingRight() - getPaddingRight();
		int t = getCompoundPaddingTop() - getPaddingTop();
		int b = getCompoundPaddingBottom() - getPaddingBottom();
		if (l != tlCompoundLeft || r != tlCompoundRight || t != tlCompoundTop || b != tlCompoundBottom) {
			tlCompoundLeft = l;
			tlCompoundRight = r;
			tlCompoundTop = t;
			tlCompoundBottom = b;
			native_setCompoundPadding4(widget, l, t, r, b);
		}
	}
