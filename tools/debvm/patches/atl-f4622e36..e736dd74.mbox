@@ -0,0 +1,44 @@
+package android.app.usage;
+
+import android.os.UserHandle;
+import java.io.File;
+import java.io.IOException;
+import java.util.UUID;
+
+/* teslalinux: Waze's Application.onCreate queries storage stats for itself. Report the data dir's
+ * real usage and the root filesystem's free/total space. */
+public class StorageStatsManager {
+	public StorageStatsManager() {}
+
+	public long getTotalBytes(UUID storageUuid) throws IOException {
+		return new File("/").getTotalSpace();
+	}
+
+	public long getFreeBytes(UUID storageUuid) throws IOException {
+		return new File("/").getUsableSpace();
+	}
+
+	public StorageStats queryStatsForPackage(UUID storageUuid, String packageName, UserHandle user) throws IOException {
+		return new StorageStats();
+	}
+
+	public StorageStats queryStatsForUid(UUID storageUuid, int uid) throws IOException {
+		return new StorageStats();
+	}
+
+	public StorageStats queryStatsForUser(UUID storageUuid, UserHandle user) throws IOException {
+		return new StorageStats();
+	}
+
+	public ExternalStorageStats queryExternalStatsForUser(UUID storageUuid, UserHandle user) throws IOException {
+		return new ExternalStorageStats();
+	}
+
+	public static class ExternalStorageStats {
+		public long getTotalBytes() { return 0; }
+		public long getAudioBytes() { return 0; }
+		public long getVideoBytes() { return 0; }
+		public long getImageBytes() { return 0; }
+		public long getAppBytes() { return 0; }
+	}
+}
diff --git a/src/api-impl/android/content/AttributionSource.java b/src/api-impl/android/content/AttributionSource.java
new file mode 100644
index 00000000..1dad8709
--- /dev/null
+++ b/src/api-impl/android/content/AttributionSource.java
@@ -0,0 +1,41 @@
+package android.content;
+
+import android.os.Process;
+
+/* teslalinux: API 31 attribution plumbing; Firebase's init provider calls Context.getAttributionSource().
+ * There is one process and one app, so a single static source describes everything. */
+public final class AttributionSource {
+	private final int uid;
+	private final String packageName;
+	private final String attributionTag;
+
+	public AttributionSource() {
+		this(Process.myUid(), null, null);
+	}
+
+	public AttributionSource(int uid, String packageName, String attributionTag) {
+		this.uid = uid;
+		this.packageName = packageName;
+		this.attributionTag = attributionTag;
+	}
+
+	public int getUid() { return uid; }
+	public int getPid() { return Process.myPid(); }
+	public String getPackageName() { return packageName; }
+	public String getAttributionTag() { return attributionTag; }
+	public AttributionSource getNext() { return null; }
+	public boolean checkCallingUid() { return true; }
+	public boolean isTrusted(Context context) { return true; }
+
+	public static final class Builder {
+		private final int uid;
+		private String packageName;
+		private String attributionTag;
+		public Builder(int uid) { this.uid = uid; }
+		public Builder(AttributionSource current) { this.uid = current.uid; this.packageName = current.packageName; this.attributionTag = current.attributionTag; }
+		public Builder setPackageName(String packageName) { this.packageName = packageName; return this; }
+		public Builder setAttributionTag(String attributionTag) { this.attributionTag = attributionTag; return this; }
+		public Builder setNext(AttributionSource next) { return this; }
+		public AttributionSource build() { return new AttributionSource(uid, packageName, attributionTag); }
+	}
+}
