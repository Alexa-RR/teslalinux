@@ -708,6 +708,26 @@ v3d_job_submit(struct v3d_context *v3d, struct v3d_job *job)

         v3d_clif_dump(v3d, job);

+        /* A bin job that waits on our out_sync runs after every job this
+         * context submitted before it has completed.  Then number this job
+         * and mark what it writes (v3d_vs_textures_need_bin_sync()).
+         */
+        if (job->submit.in_sync_bcl == v3d->out_sync)
+                v3d->bin_synced_seqno = v3d->submit_seqno;
+        v3d->submit_seqno++;
+        for (int i = 0; i < job->nr_cbufs; i++)
+                v3d_resource_gpu_written(v3d, job->cbufs[i].texture);
+        v3d_resource_gpu_written(v3d, job->zsbuf.texture);
+        v3d_resource_gpu_written(v3d, job->dbuf.texture);
+        if (job->write_prscs) {
+                set_foreach(job->write_prscs, entry)
+                        v3d_resource_gpu_written(v3d, (struct pipe_resource *)entry->key);
+        }
+        if (job->tf_write_prscs) {
+                set_foreach(job->tf_write_prscs, entry)
+                        v3d_resource_gpu_written(v3d, (struct pipe_resource *)entry->key);
+        }
+
