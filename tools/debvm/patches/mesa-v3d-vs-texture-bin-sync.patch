+/**
+ * A render or TFU job this context is about to submit (as submit_seqno)
+ * writes PRSC.
+ */
+void
+v3d_resource_gpu_written(struct v3d_context *v3d, struct pipe_resource *prsc)
+{
+        if (!prsc)
+                return;
+        struct v3d_resource *rsc = v3d_resource(prsc);
+        rsc->gpu_write_ctx = v3d->ctx_id;
+        rsc->gpu_write_seqno = v3d->submit_seqno;
+        if (rsc->separate_stencil) {
+                rsc->separate_stencil->gpu_write_ctx = v3d->ctx_id;
+                rsc->separate_stencil->gpu_write_seqno = v3d->submit_seqno;
+        }
+}
+
+/**
+ * Whether a draw whose vertex (coordinate) shader samples the bound vertex
+ * textures needs its bin job to wait for the last rendering: the binner runs
+ * the coordinate shader before the job's render, and the kernel orders bin
+ * jobs only by their explicit in_sync, so a texture a still running GPU job
+ * writes must be waited for.  That is the case when the texture's last GPU
+ * write was a job of this context after the last bin job that waited (it may
+ * still be running), or a job of another context (which nothing here can tell
+ * finished: as before, wait on our own last rendering).  A texture no GPU job
+ * wrote (uploaded through a CPU map, which waits for the BO to be idle) or
+ * whose writer completed before an earlier waiting bin job needs no wait.
+ */
+bool
+v3d_vs_textures_need_bin_sync(struct v3d_context *v3d)
+{
+        struct v3d_texture_stateobj *stage_tex = &v3d->tex[MESA_SHADER_VERTEX];
+
+        for (int i = 0; i < stage_tex->num_textures; i++) {
+                struct pipe_sampler_view *pview = stage_tex->textures[i];
+                if (!pview)
+                        continue;
+                /* the view's own resource, and the shadow copy the TMU
+                 * actually samples when there is one (written by a blit) */
+                struct pipe_resource *sampled[2] = {
+                        pview->texture, v3d_sampler_view(pview)->texture
+                };
+                for (int j = 0; j < 2; j++) {
+                        if (!sampled[j])
+                                continue;
+                        struct v3d_resource *rsc = v3d_resource(sampled[j]);
+                        if (!rsc->gpu_write_ctx)
+                                continue;
+                        if (rsc->gpu_write_ctx != v3d->ctx_id ||
+                            rsc->gpu_write_seqno > v3d->bin_synced_seqno)
+                                return true;
+                }
+        }
+        return false;
+}
+
 /**
  * Flushes the current job to get up-to-date primitive counts written to the
  * primitive counts BO, then accumulates the transform feedback primitive count
@@ -451,6 +510,9 @@ v3d_context_create(struct pipe_screen *pscreen, void *priv, unsigned flags)
                 return NULL;
         }

+        static uint32_t next_ctx_id;
+        v3d->ctx_id = p_atomic_inc_return(&next_ctx_id);
+
         pctx->screen = pscreen;
         pctx->priv = priv;
         pctx->destroy = v3d_context_destroy;
