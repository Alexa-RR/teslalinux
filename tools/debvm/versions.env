# teslalinux native Pi OS build: every source the Debian trixie arm64 build (build-dist.sh) uses,
# pinned. Sourced by build-dist.sh in the guest; the package versions in dist/MANIFEST come from here.
#
# The ATL stack pins are what the Alpine ATL VM runs today, as far as the repo records it:
#   ATL: our fork (upstream f4622e36 plus every teslalinux ATL change as commits; README there).
#        New ATL work is committed to the fork and this pin moved; the patch scripts under
#        tools/atl-vm/patches are the history it was built from.
#   art_standalone, bionic_translation, libopensles-standalone: Alpine edge/testing's APKBUILD pins
#   (2026-11-09). The VM got its packages from edge/testing when it was provisioned, so confirm
#   them against the VM before the first dist build:
#     tools/atl-vm/vm-mac.sh ssh 'apk info -v art_standalone bionic_translation libopensles-standalone wolfssl-jni'
#   and the apk's commit from its pkgver date (0_gitYYYYMMDD) against the APKBUILD history.

# --- ATL stack ---
ATL_REPO=https://github.com/Alexa-RR/android_translation_layer.git
ATL_COMMIT=1235b18e5af3db75c3064a081f6871914cb37a6e
# D8 for ATL's Java (the fork's -Dr8_jar): dx turns lambdas into invoke-custom, which ART cannot run.
# The same pin as tools/atl-vm/hostbuild-setup.sh (Google Maven com.android.tools:r8).
R8_VERSION=9.5.29
R8_URL=https://dl.google.com/android/maven2/com/android/tools/r8/9.5.29/r8-9.5.29.jar
R8_SHA256=f8c762ff84640b10083b934a47278758a7665977e618fab0c927fff00521dea3
ART_REPO=https://gitlab.com/android_translation_layer/art_standalone.git
ART_COMMIT=a1edfc40e8cea3644d80e4e776d3fa7fc397a1c2          # Alpine art_standalone 0_git20261018-r0
BIONIC_REPO=https://gitlab.com/android_translation_layer/bionic_translation.git
BIONIC_COMMIT=6253dec7                                         # Alpine bionic_translation 0_git20260927
OPENSLES_REPO=https://gitlab.com/android_translation_layer/libopensles-standalone.git
OPENSLES_COMMIT=bdb857a4                                       # Alpine libopensles-standalone 0_git20250913
WOLFSSL_REPO=https://github.com/wolfSSL/wolfssl.git
WOLFSSL_TAG=v5.9.4-stable                                      # Alpine community/wolfssl 5.9.4, Flathub
# ATL doc/Build.md's configure flags (Flathub uses exactly these)
WOLFSSL_FLAGS="--enable-shared --disable-opensslall --disable-opensslextra --enable-aescbc-length-checks --enable-curve25519 --enable-ed25519 --enable-ed25519-stream --enable-oldtls --enable-base64encode --enable-tlsx --enable-scrypt --disable-examples --enable-crl --enable-jni --enable-sessioncerts"
VIXL_URL=https://github.com/Linaro/vixl/archive/refs/tags/8.0.0.tar.gz   # trixie has 5.1.0; every working build uses 8.0.0
# Alpine's meson build for vixl (Flathub carries the same idea); the fetched file's sha256 is
# printed and checked against VIXL_MESON_PATCH_SHA256 once that is recorded
VIXL_MESON_PATCH_URL=https://raw.githubusercontent.com/alpinelinux/aports/master/testing/vixl/0001-vixl-Meson-support.patch
VIXL_MESON_PATCH_SHA256=
# The ALPN API for ART's libcore (build-dist.sh step coreoj, the Linux form of
# tools/atl-vm/patch-core-oj.sh): AOSP libcore's ojluni javax.net.ssl SSLParameters, SSLSocket and
# SSLEngine at this commit (the same files as the Nov 9 build of the VM's jar), checked by sha256
LIBCORE_URL=https://android.googlesource.com/platform/libcore
LIBCORE_COMMIT=de876a01b29230b877c9f408348c38a90ee724a5
LIBCORE_SSL_SHA256="SSLParameters=576c5777c3c9e4c898a48e2c8c1d4e262af3716f1016033b1e6800776e37222c SSLSocket=3c77d8dcf0d9d6f09d614219e4d427aa03a07e58afe18abc79fec5d111581ed6 SSLEngine=2d6a14d4fff58e9db2f1423e40b74b875ad91c7df272259a745687d20c0045a4"

# --- tacomp's private stack (/opt/teslalinux/tacomp): wlroots 0.20 needs newer libs than trixie has
# (trixie: wayland 1.23.1, libdrm 2.4.124, xkbcommon 1.7.0, wayland-protocols 1.45). They live in
# their own prefix so ATL keeps linking trixie's system copies. Requirements from Debian's wlroots
# 0.20.2-1 meson.build / debian/control.
WAYLAND_REPO=https://gitlab.freedesktop.org/wayland/wayland.git
WAYLAND_TAG=1.24.0
WAYLAND_PROTOCOLS_REPO=https://gitlab.freedesktop.org/wayland/wayland-protocols.git
WAYLAND_PROTOCOLS_TAG=1.47
LIBDRM_REPO=https://gitlab.freedesktop.org/mesa/drm.git
LIBDRM_TAG=libdrm-2.4.129
XKBCOMMON_REPO=https://github.com/xkbcommon/libxkbcommon.git
XKBCOMMON_TAG=xkbcommon-1.8.1
WLROOTS_REPO=https://gitlab.freedesktop.org/wlroots/wlroots.git
WLROOTS_TAG=0.20.2

# --- toolchain ---
JDK_PKG=openjdk-21-jdk-headless   # trixie has no 8/17; javac 21 with -source 8 is reported to work
# The target CPU: the Raspberry Pi 4's Cortex-A72 (ARMv8.0-A + CRC, no LSE atomics). A build on a
# newer arm64 host (the release workflow's Neoverse runners) must not use what the Pi lacks. Debian's
# GCC already defaults to plain armv8-a (with -moutline-atomics, which picks LSE at run time) and
# nothing here uses -march=native; these make it explicit for the meson/C steps and tlplay.
TL_CPU_CFLAGS="-mcpu=cortex-a72"
TL_RUST_TARGET_CPU=cortex-a72
