class Lock:
    def __init__(self, wait):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.f = open(_p("lock"), "w")
        self.wait = wait

    def __enter__(self):
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | (0 if self.wait else fcntl.LOCK_NB))
        except BlockingIOError:
            return None
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def cmd_run(force):
    flag = _p("force")
    if os.path.exists(flag):
        force = True
        os.unlink(flag)
    with Lock(wait=False) as lk:
        if lk is None:
            log("another run holds the lock")
            return 0
        st = load_state()
        if process_upload(st, int(time.time())):  # an upload that arrived while another run was busy
            save_state(st)
        st = cycle(force)
        save_state(st)
        st = try_install_when_idle(st)
        save_state(st)
    return 0


def cmd_stage(force):
    """One cycle up to a verified, staged set (pending/), never the install: the installer runs this,
    and teslalinux-appupdate-boot.service installs the set at the next start, before the app."""
    with Lock(wait=True):
        st = load_state()
        if process_upload(st, int(time.time())):
            save_state(st)
        st = cycle(force)
        save_state(st)
    pend = st.get("pending")
    if pend:
        print("staged: %s %s (%s); installs at the next start" % (PKG, pend.get("versionName"), pend.get("versionCode")))
        return 0
    print("nothing staged: %s" % (st.get("lastMessage") or "see teslalinux-appupdate status"))
    return 0 if st.get("installed") else 1


def cmd_boot():
    with Lock(wait=True):
        st = load_state()
        if st.get("health"):
            # the previous boot ended inside a health window: this launch is checked again
            return 0
        if not st.get("pending") or not os.path.isfile(_p("pending", "base.apk")):
            return 0
        now = int(time.time())
        try:
            install_pending(st, now)
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            st.setdefault("bad", {})[str(st["pending"]["versionCode"])] = {"at": now, "reason": "install: %s" % e}
            event(st, "install-failed", "installing %s at boot failed: %s" % (st["pending"]["versionName"], e), now, notice=True)
            st["pending"] = None
            shutil.rmtree(_p("pending"), ignore_errors=True)
        save_state(st)
    return 0  # never fail the boot: the app starts with whatever is installed


def cmd_health():
    with Lock(wait=True):
        st = load_state()
        if not st.get("health"):
            return 0
        if not os.path.exists(HEALTH_ENV):  # a reboot cleared /run: the next launch logs the marker again
            os.makedirs(os.path.dirname(HEALTH_ENV), exist_ok=True)
            with open(HEALTH_ENV, "w") as f:
                f.write("ANDROID_LOG_TAGS=%s\n" % HEALTH_LOG_TAGS)
            app_ctl("restart")
        watch_health(st)
        save_state(st)
    return 0


def cmd_kick(force):
    if force:
        os.makedirs(STATE_DIR, exist_ok=True)
        open(_p("force"), "w").close()
    else:
        st = load_state()
        if time.time() - int(st.get("lastCheck") or 0) < KICK_MIN_AGE and not st.get("wanted") and not st.get("pending"):
            return 0
    if E("APPUPDATE_FAKE_APPCTL"):  # tests: no systemd
        return run([E("APPUPDATE_FAKE_APPCTL"), "kick"], check=False)
    try:
        return subprocess.run(["systemctl", "start", "--no-block", SERVICE], timeout=30).returncode
    except (OSError, subprocess.SubprocessError) as e:
        log("cannot start %s: %s" % (SERVICE, e))
        return 1


def status():
    st, settings = load_state(), load_settings()
    st["installed"] = installed_info() or st.get("installed")
    st.pop("history", None)
    return {"settings": settings, "source": effective_source(settings), "state": st, "upload": upload_status(),
            "defaultDispenser": DEFAULT_DISPENSER, "authCached": os.path.exists(AUTH_FILE)}


def cmd_rollback():
    with Lock(wait=True):
        st = load_state()
        ok = rollback(st, "rolled back by hand", int(time.time()))
        save_state(st)
    return 0 if ok else 1


def main(argv):
    if not argv:
        sys.exit(__doc__)
    cmd, rest = argv[0], argv[1:]
    force = "--force" in rest
    if cmd == "run":
        return cmd_run(force)
    if cmd == "stage":
        return cmd_stage(force)
    if cmd == "boot":
        return cmd_boot()
    if cmd == "health":
        return cmd_health()
    if cmd == "kick":
        return cmd_kick(force)
    if cmd == "status":
        print(json.dumps(status(), indent=1, sort_keys=True))
        return 0
    if cmd == "rollback":
        return cmd_rollback()
    if cmd == "receive-upload":
        args = dict(zip(rest[0::2], rest[1::2]))
        try:
            size = int(args.get("--size", "0"))
        except ValueError:
            size = 0
        return cmd_receive_upload(size, args.get("--name", "bundle"))
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
