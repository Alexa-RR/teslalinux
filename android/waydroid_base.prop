# teslalinux: properties injected into the Waydroid container.
# Install as /var/lib/waydroid/waydroid_base.prop (Waydroid merges it at container start).

# ---- Display: fixed headless size, matches tacomp's output and the touch coordinate space.
persist.waydroid.width=1088
persist.waydroid.height=832
persist.waydroid.multi_windows=false
persist.waydroid.cursor_on_subsurface=false
persist.waydroid.fake_touch=*
persist.waydroid.fake_wifi=*
ro.sf.lcd_density=200
persist.sys.rotation_lock=1
# Landscape only
persist.demo.hdmirotationlock=true
persist.demo.rotationlock=true
persist.demo.userrotation=0

# ---- Boot speed (Lepton-derived)
config.disable_cameraservice=true
config.disable_otadexopt=true
config.disable_systemtextclassifier=true
config.disable_networktime=true
debug.sf.nobootanimation=1
ro.boot.nobootanimation=1
persist.sys.disable_rescue=true
ro.surface_flinger.running_without_sync_framework=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
debug.sf.latch_unsignaled=1
debug.sf.disable_backpressure=1
# Stop the OTA dexopt / background compile storms after boot
pm.dexopt.bg-dexopt=skip
pm.dexopt.boot-after-ota=skip
pm.dexopt.inactive=skip
dalvik.vm.usejit=true
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.6
dalvik.vm.heapminfree=8m
dalvik.vm.heapmaxfree=16m

# ---- Memory: 4 GB Pi shared with the host. Aggressive LMK (upstream + Lepton values).
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.critical=0
ro.lmk.critical_upgrade=false
ro.lmk.upgrade_pressure=100
ro.lmk.downgrade_pressure=100
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.use_minfree_levels=true

# ---- GPU: Mesa v3d via gbm gralloc. Waydroid auto-detects /dev/dri/renderD128; these pin it.
ro.hardware.gralloc=gbm
ro.hardware.egl=mesa
ro.hardware.hwcomposer=waydroid
ro.hardware.vulkan=broadcom
ro.opengles.version=196608
# Uncomment if GL version probing fails on v3d (reported on trixie):
# mesa.gl.version.override=3.3

# ---- Devices that don't exist here
ro.vendor.waydroid.no_bluetooth=1
persist.waydroid.suspend=false

# ---- GPS (Phase 1: mock-location feeder on the host side; see services/gps)
persist.teslalinux.gps.port=9997
